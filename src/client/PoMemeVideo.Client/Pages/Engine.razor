@page "/engine/{SessionId:guid}"
@inject NavigationManager Nav
@inject HttpClient Http
@inject IConfiguration Configuration
@inject IJSRuntime JS
@implements IAsyncDisposable

<PageTitle>PoMemeVideo — Engine</PageTitle>

<div class="engine-page">
    <MockDataBanner />

    @if (_mockFallbackActive)
    {
        <MockDataBanner ForceShow="true" Message="⚠ FALLBACK DIRECTOR ACTIVE — SCRIPT ENTRIES ARE USING MOCK OUTPUT ⚠" />
    }

    <pre class="page-header">
╔═══════════════════════════════════════════════════════╗
║  PoMemeVideo // PROCESSING ENGINE                     ║
║  SESSION: @SessionId                                  ║
╚═══════════════════════════════════════════════════════╝</pre>

    @if (_hubClient is not null)
    {
        <div class="engine-grid">
            <!-- Top-right: Hardware Monitor -->
            <div class="hw-panel ascii-border-double">
                <HardwareMonitor HubClient="_hubClient" />
            </div>

            <!-- Left: Director's Script Feed -->
            <div class="script-panel ascii-border-double">
                <DirectorScriptFeed HubClient="_hubClient" />
            </div>

            <!-- Right: Director's Log Feed -->
            <div class="log-panel ascii-border-double">
                <DirectorLogFeed HubClient="_hubClient" />
            </div>

            <!-- Bottom: System Audit Box -->
            <div class="audit-panel ascii-border-double">
                <SystemAuditBox HubClient="_hubClient" />
            </div>
        </div>
    }

    @if (!string.IsNullOrEmpty(_errorMessage))
    {
        <pre class="error-box">[ENGINE ERROR] @_errorMessage</pre>
    }
</div>

@code {
    [Parameter] public Guid SessionId { get; set; }

    private EngineHubClient? _hubClient;
    private string? _errorMessage;
    private bool _mockFallbackActive;

    protected override async Task OnInitializedAsync()
    {
        var apiBase = Configuration["ApiBaseUrl"] ?? Nav.BaseUri.TrimEnd('/');
        var hubUrl = apiBase.TrimEnd('/') + "/hubs/engine";
        _hubClient = new EngineHubClient(hubUrl);

        _hubClient.ProcessingComplete += OnComplete;
        _hubClient.ProcessingError += OnError;
        _hubClient.DirectorLogEntry += OnDirectorLogEntry;
        _hubClient.BrowserLLMInferenceRequest += OnBrowserLLMInferenceRequest;

        await _hubClient.JoinSessionAsync(SessionId);

        // Fire-and-forget: initiate engine pipeline
        _ = Task.Run(async () =>
        {
            try
            {
                var response = await Http.PostAsync(
                    $"/api/processing/sessions/{SessionId}/initiate",
                    null);

                if (!response.IsSuccessStatusCode)
                {
                    var body = await response.Content.ReadAsStringAsync();
                    _errorMessage = $"HTTP {(int)response.StatusCode}: {body}";
                    await InvokeAsync(StateHasChanged);
                }
            }
            catch (Exception ex)
            {
                _errorMessage = ex.Message;
                await InvokeAsync(StateHasChanged);
            }
        });
    }

    private void OnComplete(string outputBlobPath)
    {
        InvokeAsync(() => Nav.NavigateTo($"/reveal/{SessionId}"));
    }

    private void OnError(string message)
    {
        _errorMessage = message;
        InvokeAsync(StateHasChanged);
    }

    private void OnDirectorLogEntry(string message)
    {
        if (!_mockFallbackActive && message.Contains("MOCK DIRECTOR", StringComparison.OrdinalIgnoreCase))
        {
            _mockFallbackActive = true;
            InvokeAsync(StateHasChanged);
        }
    }

    // ── Browser LLM round-trip ─────────────────────────────────────────────
    // The server pauses the Director step and asks this client to run inference
    // locally via Transformers.js, then POST the result back.
    private void OnBrowserLLMInferenceRequest(string payloadJson)
    {
        _ = Task.Run(async () =>
        {
            try
            {
                // Run Transformers.js in browser — may take 5–30 s on first run
                // while the ONNX model is being downloaded and cached.
                var entriesJson = await JS.InvokeAsync<string>("browserLLM.generate", payloadJson);

                // Parse sessionId from the payload so we know which endpoint to hit
                using var doc = System.Text.Json.JsonDocument.Parse(payloadJson);
                var sid = doc.RootElement.GetProperty("sessionId").GetGuid();

                // POST the raw JSON array back; the server deserialises and resolves the TCS
                using var content = new StringContent(
                    $"{{\"entries\":{entriesJson}}}",
                    System.Text.Encoding.UTF8,
                    "application/json");

                await Http.PostAsync(
                    $"/api/processing/sessions/{sid}/browser-director-result",
                    content);
            }
            catch (Exception ex)
            {
                _errorMessage = $"BrowserLLM error: {ex.Message}";
                await InvokeAsync(StateHasChanged);
            }
        });
    }

    public async ValueTask DisposeAsync()
    {
        if (_hubClient is not null)
        {
            _hubClient.ProcessingComplete -= OnComplete;
            _hubClient.ProcessingError -= OnError;
            _hubClient.DirectorLogEntry -= OnDirectorLogEntry;
            _hubClient.BrowserLLMInferenceRequest -= OnBrowserLLMInferenceRequest;
            await _hubClient.LeaveSessionAsync(SessionId);
            await _hubClient.DisposeAsync();
        }
    }
}
