@page "/engine/{SessionId:guid}"
@page "/engine"
@inject NavigationManager Nav
@inject HttpClient Http
@inject IConfiguration Configuration
@inject IJSRuntime JS
@implements IAsyncDisposable

@if (SessionId == Guid.Empty)
{
    <PageTitle>PoMemeVideo — No Session</PageTitle>
    <div class="engine-page">
        <h3>No Session Selected</h3>
        <p>Select a video from your history to view its processing engine.</p>
        <a href="/results" class="ascii-btn">[ Go to History ]</a>
    </div>
    return;
}

<PageTitle>PoMemeVideo — Processing</PageTitle>

<div class="engine-page">
    <MockDataBanner />

    <div class="engine-hero">
        <h1 class="engine-hero-title">Processing Your Video</h1>
        <p class="engine-hero-session">Session: @SessionId</p>
    </div>

    @if (_hubClient is not null)
    {
        <div class="engine-progress-strip">
            <div class="engine-progress-step step-done">
                <span class="step-dot"></span> Connected
            </div>
            <span class="engine-step-sep">›</span>
            <div class="engine-progress-step step-done">
                <span class="step-dot"></span> Video Ready
            </div>
            <span class="engine-step-sep">›</span>
            <div class="engine-progress-step step-active">
                <span class="step-dot"></span> AI Directing…
            </div>
            <span class="engine-step-sep">›</span>
            <div class="engine-progress-step">
                <span class="step-dot"></span> Rendering
            </div>
            <span class="engine-step-sep">›</span>
            <div class="engine-progress-step">
                <span class="step-dot"></span> Complete
            </div>
        </div>

        <div class="engine-grid">
            <!-- Left: AI Director's Script — primary panel -->
            <div class="script-panel ascii-border-double engine-script-panel">
                <div class="engine-panel-title">
                    <span>AI Director's Script</span>
                    <span style="font-size:0.68rem; color:var(--term-muted); font-weight:normal;">sounds added and why — live</span>
                </div>
                <DirectorScriptFeed HubClient="_hubClient" />
            </div>

            <!-- Right: Processing Log -->
            <div class="log-panel ascii-border-double engine-log-panel">
                <div class="engine-panel-title">Processing Log</div>
                <DirectorLogFeed HubClient="_hubClient" />
            </div>

            @if (_showAdvancedPanels)
            {
                <div class="hw-panel ascii-border-double">
                    <HardwareMonitor HubClient="_hubClient" />
                </div>

                <div class="audit-panel ascii-border-double">
                    <SystemAuditBox HubClient="_hubClient" />
                </div>
            }
        </div>

        <div style="margin-top: 0.75rem;">
            <button class="ascii-btn compact-btn" @onclick="ToggleAdvancedPanels">
                @(_showAdvancedPanels ? "[ Hide Technical Panels ]" : "[ Show Technical Panels ]")
            </button>
        </div>
    }

    @if (!string.IsNullOrEmpty(_errorMessage))
    {
        <pre class="error-box">[PROCESSING ERROR] @_errorMessage</pre>
    }
</div>

@code {
    [Parameter] public Guid SessionId { get; set; }

    private EngineHubClient? _hubClient;
    private string? _errorMessage;
    private bool _showAdvancedPanels;

    private void ToggleAdvancedPanels()
    {
        _showAdvancedPanels = !_showAdvancedPanels;
    }

    protected override async Task OnInitializedAsync()
    {
        var apiBase = Configuration["ApiBaseUrl"] ?? Nav.BaseUri.TrimEnd('/');
        var hubUrl = apiBase.TrimEnd('/') + "/hubs/engine";
        _hubClient = new EngineHubClient(hubUrl);

        _hubClient.ProcessingComplete += OnComplete;
        _hubClient.ProcessingError += OnError;
        _hubClient.BrowserLLMInferenceRequest += OnBrowserLLMInferenceRequest;

        await _hubClient.JoinSessionAsync(SessionId);

        // Verify session exists before firing initiate (pre-flight check).
        _ = Task.Run(async () =>
        {
            try
            {
                // Pre-flight: check session existence to avoid noisy 404 errors.
                var checkResponse = await Http.GetAsync(
                    $"/api/output/sessions/{SessionId}/script");
                if (!checkResponse.IsSuccessStatusCode)
                {
                    var body = await checkResponse.Content.ReadAsStringAsync();
                    _errorMessage = $"Session {SessionId} not found or not yet complete.";
                    await InvokeAsync(StateHasChanged);
                    return;
                }

                var response = await Http.PostAsync(
                    $"/api/processing/sessions/{SessionId}/initiate",
                    null);

                if (!response.IsSuccessStatusCode)
                {
                    var body = await response.Content.ReadAsStringAsync();
                    _errorMessage = $"HTTP {(int)response.StatusCode}: {body}";
                    await InvokeAsync(StateHasChanged);
                }
            }
            catch (Exception ex)
            {
                _errorMessage = ex.Message;
                await InvokeAsync(StateHasChanged);
            }
        });
    }

    private void OnComplete(string outputBlobPath)
    {
        InvokeAsync(() => Nav.NavigateTo($"/reveal/{SessionId}"));
    }

    private void OnError(string message)
    {
        _errorMessage = message;
        InvokeAsync(StateHasChanged);
    }

    // ── Browser LLM round-trip ─────────────────────────────────────────────
    // The server pauses the Director step and asks this client to run inference
    // locally via Transformers.js, then POST the result back.
    private void OnBrowserLLMInferenceRequest(string payloadJson)
    {
        _ = Task.Run(async () =>
        {
            try
            {
                // Run Transformers.js in browser — may take 5–30 s on first run
                // while the ONNX model is being downloaded and cached.
                var entriesJson = await JS.InvokeAsync<string>("browserLLM.generate", payloadJson);

                // Parse sessionId from the payload so we know which endpoint to hit
                using var doc = System.Text.Json.JsonDocument.Parse(payloadJson);
                var sid = doc.RootElement.GetProperty("sessionId").GetGuid();

                // POST the raw JSON array back; the server deserialises and resolves the TCS
                using var content = new StringContent(
                    $"{{\"entries\":{entriesJson}}}",
                    System.Text.Encoding.UTF8,
                    "application/json");

                await Http.PostAsync(
                    $"/api/processing/sessions/{sid}/browser-director-result",
                    content);
            }
            catch (Exception ex)
            {
                _errorMessage = $"BrowserLLM error: {ex.Message}";
                await InvokeAsync(StateHasChanged);
            }
        });
    }

    public async ValueTask DisposeAsync()
    {
        if (_hubClient is not null)
        {
            _hubClient.ProcessingComplete -= OnComplete;
            _hubClient.ProcessingError -= OnError;
            _hubClient.BrowserLLMInferenceRequest -= OnBrowserLLMInferenceRequest;
            await _hubClient.LeaveSessionAsync(SessionId);
            await _hubClient.DisposeAsync();
        }
    }
}
