@page "/"
@page "/source"
@inject HttpClient Http
@inject NavigationManager Nav
@inject IJSRuntime JS
@using Microsoft.AspNetCore.Components.Forms
@using PoMemeVideo.Client.Services
@using PoMemeVideo.Client.Components
@using PoMemeVideo.Shared.Enums

<PageTitle>PoMemeVideo — Source</PageTitle>

<div class="source-page">
    <pre class="page-header">
╔═══════════════════════════════════════════════════════╗
║  PoMemeVideo // VIDEO INGESTION TERMINAL              ║
║  [ DROP VIDEO → GENERATE KEYFRAMES → INITIATE ]      ║
╚═══════════════════════════════════════════════════════╝</pre>

    @if (_devHealth is not null)
    {
        <div class="dev-health-panel ascii-border-double">
            <pre class="vision-header">╔══════════════════════════════════════╗
║  LOCAL DEV STATUS                   ║
╚══════════════════════════════════════╝</pre>
            <pre class="vision-entry"> APP        │ @_devHealth.Status.ToUpperInvariant()</pre>
            <pre class="vision-entry"> AI         │ @_aiProviderStatus</pre>
            @foreach (var check in _devHealth.Checks.OrderBy(k => k.Key))
            {
                <pre class="vision-entry"> @check.Key.PadRight(10).ToUpperInvariant() │ @check.Value</pre>
            }

            <div class="home-ai-selector">
                <pre class="vision-entry"> MODEL      │ @_displayActiveModel</pre>

                <div class="home-ai-options">
                    <label class="ascii-toggle">
                        <input type="radio" name="ai-provider" value="AzureOpenAI" checked="@(_pendingProvider == "AzureOpenAI")" @onchange='() => SelectProvider("AzureOpenAI")' />
                        [ REMOTE OPENAI ]
                    </label>
                    <label class="ascii-toggle">
                        <input type="radio" name="ai-provider" value="BrowserLLM" checked="@(_pendingProvider == "BrowserLLM")" @onchange='() => SelectProvider("BrowserLLM")' />
                        [ LOCAL WEBGPU ]
                    </label>
                </div>

                @if (_pendingProvider == "BrowserLLM")
                {
                    <div class="home-ai-model-row">
                        @if (_localModels.Count > 0)
                        {
                            <span>[ LOCAL MODEL ]</span>
                            <select class="home-ai-model-select" @bind="_pendingBrowserModelId" @bind:after="RecomputeModelDirty">
                                @foreach (var model in _localModels)
                                {
                                    <option value="@model.Id">@model.Label</option>
                                }
                            </select>
                        }
                        else
                        {
                            <span>[ NO LOCAL MODELS - RUN: python tools/download-models.py ]</span>
                        }
                    </div>
                }

                @if (_modelDirty)
                {
                    <button class="ascii-btn" @onclick="ApplyModelAsync" disabled="@_modelApplying">
                        @(_modelApplying ? "[ APPLYING MODEL... ]" : "[ APPLY MODEL ]")
                    </button>
                }

                @if (!string.IsNullOrWhiteSpace(_modelMessage))
                {
                    <pre class="clear-status">@_modelMessage</pre>
                }
            </div>
        </div>
    }

    <div style="display: @(_uploaded ? "none" : "block")">
        <AsciiDropZone OnFileAccepted="OnFileAccepted" />
    </div>

    @* Clear all data button — always visible when not processing *@
    @if (!_uploaded && !_visionInProgress && !_initiating)
    {
        <div class="clear-data-row">
            @if (_clearConfirm)
            {
                <pre class="clear-warning">⚠ THIS WILL DELETE ALL SESSION BLOBS AND METADATA. SOUND LIBRARY IS PRESERVED.</pre>
                <button class="ascii-btn clear-confirm-btn" @onclick="DoClearData" disabled="@_clearing">
                    @(_clearing ? "[ CLEARING... ]" : "[ YES — WIPE ALL DATA ]")
                </button>
                <button class="ascii-btn" @onclick='() => _clearConfirm = false'>[ CANCEL ]</button>
            }
            else
            {
                <button class="ascii-btn clear-btn" @onclick='() => _clearConfirm = true'>[ CLEAR ALL DATA ]</button>
            }
            @if (!string.IsNullOrEmpty(_clearMessage))
            {
                <pre class="clear-status">@_clearMessage</pre>
            }
        </div>
    }

    @* Hidden video element used for keyframe extraction — not visible to the user *@
    <video @ref="_videoRef"
           style="display:none"
           preload="metadata"
           muted
           playsinline>
    </video>

    @if (_selectedFile is not null && !_uploaded)
    {
        <div class="upload-status ascii-border-double">
            <pre>
 FILE    : @_selectedFile.Name
 SIZE    : @(_selectedFile.Size / 1024 / 1024) MB
 STATUS  : @_statusMessage</pre>

            @if (_uploadProgress > 0 && _uploadProgress < 100)
            {
                <pre class="progress-bar">[ @ProgressBar(_uploadProgress) ] @_uploadProgress%</pre>
            }
        </div>
    }

    @if (_keyframeStripVisible)
    {
        <DitheredKeyframeStrip @ref="_keyframeStrip" VideoElement="_videoRef" />

        @if (_visionLabels.Count > 0)
        {
            <div class="vision-labels ascii-border-double">
                <pre class="vision-header">╔══════════════════════════════════════╗
║  AI VISION ANALYSIS — SCENE LABELS  ║
╚══════════════════════════════════════╝</pre>
                @foreach (var label in _visionLabels)
                {
                    <pre class="vision-entry"> t=@(label.TimestampSeconds.ToString("F1"))s │ @label.Label.ToUpperInvariant()</pre>
                }
            </div>
        }
        else if (_visionAnalysed)
        {
            <pre class="vision-fallback"> AI VISION: no triggers detected — time-based placement will be used</pre>
        }

        <div class="controls">
            <label class="ascii-toggle">
                <input type="checkbox" @bind="_aggressiveVisuals" />
                [ AGGRESSIVE VISUALS : @(_aggressiveVisuals ? "ON " : "OFF") ]
            </label>

            <button class="ascii-btn initiate-btn"
                    @onclick="OnInitiate"
                    disabled="@(_initiating || _visionInProgress)">
                @if (_visionInProgress)
                {
                    <span>[ ANALYSING... PLEASE WAIT ]</span>
                }
                else
                {
                    <span>@(_initiating ? "[ INITIATING... ]" : "[ INITIATE ]")</span>
                }
            </button>
        </div>
    }

    @if (!string.IsNullOrEmpty(_errorMessage))
    {
        <pre class="page-error">⚠ @_errorMessage</pre>
    }
</div>

@code {
    // State
    private IBrowserFile? _selectedFile;
    private bool _uploaded;
    private bool _keyframeStripVisible;
    private bool _aggressiveVisuals;
    private bool _initiating;
    private bool _visionInProgress;
    private bool _clearConfirm;
    private bool _clearing;
    private string? _clearMessage;
    private int _uploadProgress;
    private string _statusMessage = "PENDING";
    private string? _errorMessage;

    // Session data returned by the API
    private Guid _sessionId;
    private string _blobPath = string.Empty;
    private double _videoDurationSeconds;

    // Vision analysis results
    private readonly List<VisionLabel> _visionLabels = [];
    private bool _visionAnalysed;
    private HealthResponse? _devHealth;
    private string _aiProviderStatus = "UNKNOWN";
    private string _displayActiveModel = "UNKNOWN";

    private string _activeProvider = "BrowserLLM";
    private string _pendingProvider = "BrowserLLM";
    private string _activeBrowserModelId = "smollm2-360m-instruct-onnx";
    private string _pendingBrowserModelId = "smollm2-360m-instruct-onnx";
    private List<LocalModelInfo> _localModels = [];
    private bool _modelDirty;
    private bool _modelApplying;
    private string? _modelMessage;

    private sealed record VisionLabel(double TimestampSeconds, string Label);
    private sealed record HealthResponse(string Status, Dictionary<string, string> Checks);
    private sealed record AiModelResponse(string Provider, string? BrowserLLMModel, LocalModelInfo[]? LocalModels, bool IsDevelopment);
    private sealed record LocalModelInfo(string Id, string Label);

    private sealed record FrameUploadResult(
        int FramesStored,
        VisionLabelItem[]? VisionLabels);

    private sealed record VisionLabelItem(double TimestampSeconds, string Label);

    // Component refs
    private ElementReference _videoRef;
    private DitheredKeyframeStrip? _keyframeStrip;

    protected override async Task OnInitializedAsync()
    {
        await LoadDevStatusAsync();
    }

    private async Task OnFileAccepted(IBrowserFile file)
    {
        _selectedFile = file;
        _errorMessage = null;
        _uploadProgress = 0;
        _statusMessage = "REQUESTING SAS TOKEN...";
        StateHasChanged();

        try
        {
            // Step 1 — request SAS token from API
            var sasResponse = await Http.PostAsJsonAsync("/api/ingestion/sas", new
            {
                fileName = file.Name,
                fileSizeBytes = file.Size,
            });

            if (!sasResponse.IsSuccessStatusCode)
            {
                ErrorResponse? err = null;
                try { err = await sasResponse.Content.ReadFromJsonAsync<ErrorResponse>(); } catch { }
                _errorMessage = $"SAS ERROR: {err?.Message ?? sasResponse.ReasonPhrase} ({(int)sasResponse.StatusCode})";
                _statusMessage = "FAILED";
                return;
            }

            var sas = await sasResponse.Content.ReadFromJsonAsync<SasTokenResponse>()
                ?? throw new InvalidOperationException("Empty SAS response");

            _sessionId = sas.SessionId;
            _blobPath = ExtractBlobPath(sas.SasUrl);
            _statusMessage = "UPLOADING...";
            StateHasChanged();

            // Step 2 — upload directly to Azure Blob Storage via SAS
            var uploadService = new BlobUploadService(new HttpClient());
            var progress = new Progress<int>(p =>
            {
                _uploadProgress = p;
                InvokeAsync(StateHasChanged);
            });

            await uploadService.UploadAsync(sas.SasUrl, file, progress);
            _statusMessage = "EXTRACTING DURATION...";
            StateHasChanged();

            // Step 3 — measure video duration via the hidden <video> element
            _videoDurationSeconds = await LoadVideoDurationAsync(sas.SasUrl, file);

            // Step 4 — confirm upload with the API
            _statusMessage = "CONFIRMING SESSION...";
            StateHasChanged();

            var confirmResponse = await Http.PostAsJsonAsync("/api/ingestion/sessions", new
            {
                sessionId = _sessionId,
                blobPath = _blobPath,
                videoDurationSeconds = _videoDurationSeconds,
                aggressiveVisuals = _aggressiveVisuals,
            });

            if (!confirmResponse.IsSuccessStatusCode)
            {
                _errorMessage = "SESSION CONFIRM FAILED";
                _statusMessage = "FAILED";
                return;
            }

            _uploaded = true;
            _statusMessage = "UPLOAD COMPLETE";
            _keyframeStripVisible = true;
            StateHasChanged();

            // Step 5 — generate dithered keyframe strip (display only)
            if (_keyframeStrip is not null)
                await _keyframeStrip.GenerateAsync();

            // Step 6 — capture raw (undithered) frames and upload to API for AI vision analysis
            _visionInProgress = true;
            _statusMessage = "ANALYSING VIDEO WITH AI...";
            StateHasChanged();
            try
            {
                var rawFrames = await JS.InvokeAsync<string[]>(
                    "canvasDither.captureRawFrames",
                    "ascii-file-input",
                    _videoRef,
                    3 /* intervalSeconds */);

                if (rawFrames.Length > 0)
                {
                    var frameResponse = await Http.PostAsJsonAsync(
                        $"/api/ingestion/sessions/{_sessionId}/frames",
                        new { frames = rawFrames });

                    if (frameResponse.IsSuccessStatusCode)
                    {
                        var result = await frameResponse.Content.ReadFromJsonAsync<FrameUploadResult>();
                        _visionLabels.Clear();
                        if (result?.VisionLabels is { Length: > 0 } labels)
                            _visionLabels.AddRange(labels.Select(l => new VisionLabel(l.TimestampSeconds, l.Label)));

                        _visionAnalysed = true;
                        _statusMessage = _visionLabels.Count > 0
                            ? $"READY — {_visionLabels.Count} SCENE(S) IDENTIFIED"
                            : "READY — NO AI TRIGGERS FOUND (time-based placement will be used)";
                    }
                    else
                    {
                        _statusMessage = "READY (frame analysis failed — AI will use fallback)";
                    }
                }
                else
                {
                    _statusMessage = "READY (no frames extracted)";
                }
            }
            catch
            {
                _statusMessage = "UPLOAD COMPLETE (frame capture failed — AI will use fallback)";
            }
            finally
            {
                _visionInProgress = false;
            }
        }
        catch (Exception ex)
        {
            _errorMessage = $"ERROR: {ex.Message}";
            _statusMessage = "FAILED";
        }
        finally
        {
            StateHasChanged();
        }
    }

    private async Task OnInitiate()
    {
        _initiating = true;
        _errorMessage = null;
        StateHasChanged();

        // Update aggressive visuals before navigation if needed
        // (already confirmed at upload; this reflects any toggle change)
        // In a real implementation we'd PATCH the session, but for Phase 3 navigate directly
        Nav.NavigateTo($"/engine/{_sessionId}");
        await Task.CompletedTask;
    }

    /// <summary>
    /// Loads a video URL into the hidden video element and awaits loadedmetadata.
    /// Returns the duration in seconds, or 0 if unavailable.
    /// </summary>
    private async Task<double> LoadVideoDurationAsync(string url, IBrowserFile file)
    {
        try
        {
            // Use the already-selected ascii-file-input element via createObjectURL — no CORS issues.
            return await JS.InvokeAsync<double>("canvasDither.getFileDuration", "ascii-file-input", _videoRef);
        }
        catch
        {
            // Fallback: estimate based on file size (rough: 1 MB ≈ 1 second at typical bitrate)
            return file.Size / (1024.0 * 1024.0);
        }
    }

    /// <summary>Extracts container/blob path from a SAS URL, stripping the query string.</summary>
    private static string ExtractBlobPath(string sasUrl)
    {
        // sasUrl = https://account.blob.core.windows.net/sessions/{sessionId}/source.mp4?sv=...
        //       OR http://127.0.0.1:10000/devstoreaccount1/sessions/{sessionId}/source.mp4?sv=... (Azurite)
        var uri = new Uri(sasUrl);
        // Strip leading '/' to get: sessions/{id}/source.mp4 (Azure) or devstoreaccount1/sessions/{id}/source.mp4 (Azurite)
        var path = uri.AbsolutePath.TrimStart('/');
        // For Azurite: strip the account segment so BlobStorageService.SplitPath gets container/blob
        const string azuritePrefix = "devstoreaccount1/";
        if (path.StartsWith(azuritePrefix, StringComparison.OrdinalIgnoreCase))
            path = path[azuritePrefix.Length..];
        return path;
    }

    private static string ProgressBar(int percent)
    {
        const int width = 20;
        var filled = (int)(percent / 100.0 * width);
        return new string('█', filled) + new string('░', width - filled);
    }

    // API response models
    private sealed record SasTokenResponse(Guid SessionId, string SasUrl, DateTimeOffset ExpiresAt);
    private sealed record ErrorResponse(string Error, string Message);

    private async Task LoadDevStatusAsync()
    {
        try
        {
            _devHealth = await Http.GetFromJsonAsync<HealthResponse>("/health");
        }
        catch
        {
            _devHealth = null;
        }

        try
        {
            var ai = await Http.GetFromJsonAsync<AiModelResponse>("/api/config/ai-model");
            if (ai is not null)
            {
                _activeProvider = ai.Provider;
                _pendingProvider = ai.Provider;
                _localModels = ai.LocalModels?.ToList() ?? [];
                _activeBrowserModelId = ai.BrowserLLMModel ?? (_localModels.FirstOrDefault()?.Id ?? _activeBrowserModelId);
                _pendingBrowserModelId = _activeBrowserModelId;

                _aiProviderStatus = ai.Provider == "BrowserLLM" ? "BROWSERLLM" : "AZUREOPENAI";
                _displayActiveModel = ai.Provider == "BrowserLLM"
                    ? (_localModels.Count > 0
                        ? (_localModels.FirstOrDefault(m => m.Id == _activeBrowserModelId)?.Label ?? _activeBrowserModelId)
                        : "No local models downloaded")
                    : "Azure OpenAI (GPT-4o)";
                RecomputeModelDirty();
            }
        }
        catch
        {
            _aiProviderStatus = "UNKNOWN";
            _displayActiveModel = "UNKNOWN";
        }
    }

    private void SelectProvider(string provider)
    {
        _pendingProvider = provider;
        RecomputeModelDirty();
        _modelMessage = null;
    }

    private void RecomputeModelDirty()
    {
        _modelDirty = _pendingProvider != _activeProvider
                      || _pendingBrowserModelId != _activeBrowserModelId;
    }

    private async Task ApplyModelAsync()
    {
        _modelApplying = true;
        _modelMessage = null;
        StateHasChanged();

        try
        {
            var body = new { provider = _pendingProvider, browserLLMModel = _pendingBrowserModelId };
            var response = await Http.PutAsJsonAsync("/api/config/ai-model", body);

            if (!response.IsSuccessStatusCode)
            {
                _modelMessage = $"MODEL SWITCH FAILED: HTTP {(int)response.StatusCode}";
                return;
            }

            _activeProvider = _pendingProvider;
            _activeBrowserModelId = _pendingBrowserModelId;
            _modelDirty = false;
            _aiProviderStatus = _activeProvider == "BrowserLLM" ? "BROWSERLLM" : "AZUREOPENAI";
            _displayActiveModel = _activeProvider == "BrowserLLM"
                ? (_localModels.Count > 0
                    ? (_localModels.FirstOrDefault(m => m.Id == _activeBrowserModelId)?.Label ?? _activeBrowserModelId)
                    : "No local models downloaded")
                : "Azure OpenAI (GPT-4o)";
            _modelMessage = $"MODEL ACTIVE: {_displayActiveModel}";
        }
        catch (Exception ex)
        {
            _modelMessage = $"MODEL SWITCH FAILED: {ex.Message}";
        }
        finally
        {
            _modelApplying = false;
            StateHasChanged();
        }
    }

    private async Task DoClearData()
    {
        _clearing = true;
        _clearMessage = null;
        StateHasChanged();
        try
        {
            var response = await Http.DeleteAsync("/api/admin/data");
            _clearMessage = response.IsSuccessStatusCode
                ? "ALL SESSION DATA WIPED. SOUND LIBRARY INTACT."
                : $"ERROR: {response.StatusCode}";
        }
        catch (Exception ex)
        {
            _clearMessage = $"ERROR: {ex.Message}";
        }
        finally
        {
            _clearing = false;
            _clearConfirm = false;
            StateHasChanged();
        }
    }
}

<style>
    .source-page {
        display: flex;
        flex-direction: column;
        gap: 1rem;
        padding: 1rem;
        background: #000;
        color: #00FF41;
        font-family: 'Courier New', monospace;
        min-height: 100vh;
    }

    .page-header {
        color: #00FF41;
        margin: 0;
        font-size: 0.85rem;
        line-height: 1.3;
    }

    .upload-status pre {
        margin: 0;
        color: #00FF41;
    }

    .progress-bar {
        color: #00FF41;
        margin: 0;
    }

    .controls {
        display: flex;
        flex-direction: column;
        gap: 0.75rem;
    }

    .ascii-toggle {
        cursor: pointer;
        user-select: none;
        font-family: 'Courier New', monospace;
        color: #00FF41;
        display: flex;
        align-items: center;
        gap: 0.5rem;
    }

    .ascii-toggle input[type="checkbox"] {
        accent-color: #00FF41;
    }

    .ascii-btn {
        background: transparent;
        border: 1px solid #00FF41;
        color: #00FF41;
        font-family: 'Courier New', monospace;
        font-size: 1rem;
        padding: 0.4rem 1rem;
        cursor: pointer;
        letter-spacing: 0.05em;
    }

    .initiate-btn {
        font-size: 1.25rem;
        padding: 0.6rem 2rem;
        align-self: flex-start;
    }

    .initiate-btn:hover:not(:disabled) {
        background: #00FF41;
        color: #000;
    }

    .initiate-btn:disabled {
        opacity: 0.5;
        cursor: not-allowed;
    }

    .page-error {
        color: #FF0000;
        margin: 0;
    }

    .clear-data-row {
        display: flex;
        align-items: center;
        gap: 0.75rem;
        flex-wrap: wrap;
        margin-top: 0.5rem;
    }

    .clear-btn {
        color: #555;
        border-color: #333;
        font-size: 0.75rem;
        padding: 0.25rem 0.75rem;
        opacity: 0.6;
    }

    .clear-btn:hover {
        color: #FF4141;
        border-color: #FF4141;
        opacity: 1;
    }

    .clear-confirm-btn {
        color: #FF4141;
        border-color: #FF4141;
    }

    .clear-confirm-btn:hover:not(:disabled) {
        background: #FF4141;
        color: #000;
    }

    .clear-warning {
        color: #FF4141;
        font-size: 0.75rem;
        margin: 0;
    }

    .clear-status {
        color: #00FF41;
        font-size: 0.75rem;
        margin: 0;
    }

    .dev-health-panel {
        max-width: 44rem;
    }

    .home-ai-selector {
        margin-top: 0.75rem;
        padding-top: 0.5rem;
        border-top: 1px dashed rgba(0, 255, 65, 0.35);
        display: flex;
        flex-direction: column;
        gap: 0.5rem;
    }

    .home-ai-options {
        display: flex;
        flex-direction: column;
        gap: 0.35rem;
    }

    .home-ai-model-row {
        display: flex;
        align-items: center;
        gap: 0.5rem;
        font-size: 0.85rem;
    }

    .home-ai-model-select {
        background: #000;
        border: 1px solid #00FF41;
        color: #00FF41;
        font-family: 'Courier New', monospace;
        font-size: 0.8rem;
        padding: 0.2rem 0.35rem;
        min-width: 15rem;
    }
</style>
