@page "/reveal/{SessionId:guid}"
@inject HttpClient Http
@inject IJSRuntime JS
@inject NavigationManager Nav
@using PoMemeVideo.Shared.Models
@implements IAsyncDisposable

<PageTitle>PoMemeVideo — Review</PageTitle>

<div class="reveal-page">
    <MockDataBanner />

    <div class="page-hero">
        <h1 class="hero-title">Review Your Video</h1>
        <p class="hero-sub">Session: @SessionId</p>
    </div>

    @if (_loading)
    {
        <pre style="text-align: center; margin-top: 2rem;">[ Loading… ]</pre>
    }
    else if (!string.IsNullOrWhiteSpace(_error))
    {
        <pre class="error-box">[ ERROR ] @_error</pre>
    }
    else if (_session is not null)
    {
        <div class="reveal-grid">
            <!-- Video Player -->
            <div class="video-panel">
                @if (!string.IsNullOrWhiteSpace(_session.OutputBlobPath))
                {
                    <div class="ascii-border-double">
                        <pre class="panel-header">[ OUTPUT VIDEO ]</pre>
                        <CrtMonitorFrame>
                            <video class="output-video" autoplay controls @onloadedmetadata="OnVideoLoaded" @onerror="OnVideoError">
                                <source src="/api/output/sessions/@SessionId/stream/video" type="video/mp4" />
                                Your browser does not support the video tag.
                            </video>
                        </CrtMonitorFrame>

                        <div class="reveal-meta">
                            <pre> STATUS     : @_session.Status</pre>
                            <pre> DURATION   : @_session.VideoDurationSeconds.ToString("F1")s</pre>
                            <pre> GENERATED  : @(_session.CompletedAt?.ToLocalTime().ToString("yyyy-MM-dd HH:mm:ss") ?? "PENDING")</pre>
                            <pre> SOUNDS     : @(_script?.TotalSoundCount ?? 0)</pre>
                        </div>

                        @if (_videoLoadFailed)
                        {
                            <div class="video-fallback-box">
                                <pre>[ PLAYER FALLBACK ] Inline playback failed in this browser.</pre>
                                <a class="ascii-btn" href="/api/output/sessions/@SessionId/stream/video" target="_blank" rel="noopener noreferrer">[ OPEN DIRECT STREAM ]</a>
                            </div>
                        }
                    </div>
                }
                else
                {
                    <pre style="color: #FF4141; text-align: center; padding: 2rem;">[ OUTPUT NOT READY ]</pre>
                }
            </div>

            <!-- Director Script Panel -->
            <div class="script-panel-reveal ascii-border-double">
                <pre class="panel-header">[ AI DIRECTOR'S SCRIPT ]</pre>
                <p class="reveal-script-subtitle">What was added to your video and why</p>
                @if (_script is not null && _script.Entries.Count > 0)
                {
                    <div style="max-height: 420px; overflow-y: auto; padding: 0.5rem;">
                        @foreach (var (entry, idx) in _script.Entries.Select((e, i) => (e, i + 1)))
                        {
                            <div style="border: 1px solid #00ff41; margin-bottom: 0.75rem; padding: 0.5rem; font-family: monospace; font-size: 0.75rem; line-height: 1.5;">
                                <pre style="color:#00ff41; margin:0;">┌─ CUT @idx ── @((entry.TimestampMs / 1000.0).ToString("F1"))s ─────────────────────────┐</pre>
                                <pre style="color:#aaffaa; margin:0; white-space:pre-wrap;">  SCENE   : @(string.IsNullOrWhiteSpace(entry.SceneDescription) ? "—" : entry.SceneDescription)</pre>
                                <pre style="color:#ffff00; margin:0;">  SOUND   : @(string.IsNullOrWhiteSpace(entry.SoundName) ? entry.SoundId.ToString()[..8] + "…" : entry.SoundName)</pre>
                                <pre style="color:#ff9900; margin:0; white-space:pre-wrap;">  WHY     : @(string.IsNullOrWhiteSpace(entry.SelectionRationale) ? "—" : entry.SelectionRationale)</pre>
                                <pre style="color:#888; margin:0;">  EFFECT  : @(entry.VisualEffect?.ToString() ?? "None") · IRONIC: @(entry.IsIronic ? "YES" : "NO") · @entry.PlacementType</pre>
                                <pre style="color:#00ff41; margin:0;">└──────────────────────────────────────────────────────────┘</pre>
                            </div>
                        }
                    </div>
                }
                else if (_script is not null)
                {
                    <pre style="color: #888;">[ No script entries generated for this session ]</pre>
                }
                else if (!string.IsNullOrWhiteSpace(_scriptStatusMessage))
                {
                    <pre style="color: #FFB347; white-space: pre-wrap">@_scriptStatusMessage</pre>
                }
                else
                {
                    <pre style="color: #888;">[ Script unavailable ]</pre>
                }
            </div>

            <!-- Actions Panel -->
            <div class="controls-panel">
                <div class="reveal-actions-primary">
                    <button class="ascii-btn download-btn" @onclick="DownloadVideo">⬇ Download Video</button>
                    <button class="ascii-btn compact-btn" @onclick="DownloadScript">Download Script</button>
                </div>
                <div class="reveal-actions-secondary">
                    @if (_confirmWipe)
                    {
                        <button class="ascii-btn wipe-btn" @onclick="WipeBuffer">[ CONFIRM DELETE ]</button>
                        <button class="ascii-btn" @onclick='() => _confirmWipe = false'>[ CANCEL ]</button>
                    }
                    else
                    {
                        <button class="ascii-btn wipe-btn compact-btn" @onclick='() => _confirmWipe = true'>Delete Session</button>
                    }
                    <button class="ascii-btn compact-btn" @onclick='() => Nav.NavigateTo("/results")'>View History</button>
                        <button class="ascii-btn compact-btn" @onclick='() => Nav.NavigateTo("/")'>+ Create Another</button>
                </div>
                @if (!string.IsNullOrWhiteSpace(_statusMessage))
                {
                    <pre style="font-size: 0.8rem; margin-top: 0.5rem; color: var(--term-secondary);">@_statusMessage</pre>
                }
            </div>
        </div>

        @if (_session.Status == SessionStatus.Error)
        {
            <pre class="error-box">[ ENGINE ERROR ] @(_session.ErrorMessage ?? "Unknown engine error")</pre>
        }
    }
</div>

@code {
    [Parameter] public Guid SessionId { get; set; }

    private bool _loading = true;
    private string? _error;
    private VideoSessionDto? _session;
    private DirectorScriptDto? _script;
    private string _scriptJson = "";
    private string? _scriptStatusMessage;
    private string? _statusMessage;
    private bool _videoLoadFailed;
    private bool _confirmWipe;
    private IJSObjectReference? _revealJs;

    protected override async Task OnInitializedAsync()
    {
        _loading = true;
        _error = null;

        try
        {
            _revealJs = await JS.InvokeAsync<IJSObjectReference>("import", "/js/reveal.js");
            await _revealJs.InvokeVoidAsync("playTransition");

            // Load session data
            var sessionResponse = await Http.GetAsync($"/api/ingestion/sessions/{SessionId}");
            if (!sessionResponse.IsSuccessStatusCode)
            {
                _error = $"Failed to load session: HTTP {(int)sessionResponse.StatusCode}";
                return;
            }

            _session = await sessionResponse.Content.ReadFromJsonAsync<VideoSessionDto>();
            if (_session is null)
            {
                _error = "Session payload was empty.";
                return;
            }

            // Load director script
            try
            {
                var scriptResponse = await Http.GetAsync($"/api/output/sessions/{SessionId}/script");
                if (scriptResponse.IsSuccessStatusCode)
                {
                    _script = await scriptResponse.Content.ReadFromJsonAsync<DirectorScriptDto>();
                    if (_script is not null)
                    {
                        _scriptJson = System.Text.Json.JsonSerializer.Serialize(_script, new System.Text.Json.JsonSerializerOptions { WriteIndented = true });
                    }
                }
                else
                {
                    _scriptStatusMessage = $"[ SCRIPT STATUS ] HTTP {(int)scriptResponse.StatusCode} while loading script.";
                }
            }
            catch (Exception ex)
            {
                _scriptStatusMessage = $"[ SCRIPT STATUS ] {ex.Message}";
            }
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _loading = false;
        }
    }

    private async Task DownloadVideo()
    {
        if (_session?.OutputBlobPath is null)
        {
            _statusMessage = "Video not ready";
            return;
        }

        try
        {
            var module = await EnsureRevealModuleAsync();
            await module.InvokeVoidAsync("navigateTo", $"/api/output/sessions/{SessionId}/download/video");
            _statusMessage = "Video downloading...";
        }
        catch (Exception ex)
        {
            _statusMessage = $"Error: {ex.Message}";
        }
    }

    private async Task DownloadScript()
    {
        try
        {
            var module = await EnsureRevealModuleAsync();
            await module.InvokeVoidAsync("navigateTo", $"/api/output/sessions/{SessionId}/download/script");
            _statusMessage = "Script downloading...";
        }
        catch (Exception ex)
        {
            _statusMessage = $"Error: {ex.Message}";
        }
    }

    private async Task WipeBuffer()
    {
        _confirmWipe = false;
        _statusMessage = "Wiping buffer...";
        try
        {
            var response = await Http.DeleteAsync($"/api/output/sessions/{SessionId}");
            if (response.IsSuccessStatusCode)
            {
                Nav.NavigateTo("/");
            }
            else
            {
                _statusMessage = $"Wipe failed: HTTP {(int)response.StatusCode}";
            }
        }
        catch (Exception ex)
        {
            _statusMessage = $"Error: {ex.Message}";
        }
    }

    private void OnVideoLoaded()
    {
        _videoLoadFailed = false;
    }

    private void OnVideoError()
    {
        _videoLoadFailed = true;
        _statusMessage = "Inline video playback failed. Try direct stream or download.";
    }

    private async Task<IJSObjectReference> EnsureRevealModuleAsync()
    {
        _revealJs ??= await JS.InvokeAsync<IJSObjectReference>("import", "/js/reveal.js");
        return _revealJs;
    }

    public async ValueTask DisposeAsync()
    {
        if (_revealJs is null)
            return;

        await _revealJs.DisposeAsync();
    }
}


