@page "/reveal/{SessionId:guid}"
@inject HttpClient Http
@inject IJSRuntime JS
@inject NavigationManager Nav
@using PoMemeVideo.Shared.Models

<PageTitle>PoMemeVideo - Reveal</PageTitle>

<div class="reveal-page">
    <pre class="page-header">
╔═══════════════════════════════════════════════════════╗
║  PoMemeVideo // REVEAL                                ║
║  SESSION: @SessionId                                  ║
╚═══════════════════════════════════════════════════════╝</pre>

    @if (_loading)
    {
        <pre style="color: #00FF41; text-align: center; margin-top: 2rem;">[ INITIALIZING REVEAL... ]</pre>
    }
    else if (!string.IsNullOrWhiteSpace(_error))
    {
        <pre class="error-box">[ REVEAL ERROR ] @_error</pre>
    }
    else if (_session is not null)
    {
        <div class="reveal-grid">
            <!-- Video Player (wrapped in CRT frame) -->
            <div class="video-panel">
                @if (!string.IsNullOrWhiteSpace(_session.OutputBlobPath))
                {
                    <div class="ascii-panel">
                        <pre class="panel-header">[ OUTPUT VIDEO ]</pre>
                        <video class="output-video" autoplay muted controls style="width: 100%;">
                            <source src="/api/output/sessions/@SessionId/download/video" type="video/mp4" />
                            Your browser does not support the video tag.
                        </video>
                    </div>
                }
                else
                {
                    <pre style="color: #FF4141; text-align: center; padding: 2rem;">[ OUTPUT NOT READY ]</pre>
                }
            </div>

            <!-- Director Script Panel -->
            <div class="script-panel">
                <div class="ascii-panel">
                    <pre class="panel-header">[ DIRECTOR'S SCRIPT ]</pre>
                    @if (_script is not null && _script.Entries.Count > 0)
                    {
                        <pre style="max-height: 300px; overflow-y: auto; font-size: 0.75rem; line-height: 1.2;">@_scriptJson</pre>
                    }
                    else
                    {
                        <pre style="color: #888;">[ Script loading... ]</pre>
                    }
                </div>
            </div>

            <!-- Download & Wipe Buttons -->
            <div class="controls-panel">
                <button class="ascii-btn" @onclick="DownloadVideo">[ DOWNLOAD VIDEO ]</button>
                <button class="ascii-btn" @onclick="DownloadScript">[ DOWNLOAD SCRIPT ]</button>
                <button class="ascii-btn wipe-btn" @onclick="WipeBuffer">[ WIPE BUFFER ]</button>
                @if (!string.IsNullOrWhiteSpace(_statusMessage))
                {
                    <pre style="color: #00FF41; font-size: 0.8rem; margin-top: 0.5rem;">@_statusMessage</pre>
                }
            </div>
        </div>

        @if (_session.Status == SessionStatus.Error)
        {
            <pre class="error-box">[ ENGINE ERROR ] @(_session.ErrorMessage ?? "Unknown engine error")</pre>
        }
    }
</div>

<style>
.reveal-page {
    background: #000;
    color: #00FF41;
    font-family: 'Courier New', monospace;
    min-height: 100vh;
    padding: 1rem;
}

.page-header {
    color: #00FF41;
    margin: 0 0 1rem 0;
    font-size: 0.85rem;
    line-height: 1.3;
}

.reveal-grid {
    display: grid;
    grid-template-columns: 2fr 1fr;
    grid-template-rows: auto auto;
    gap: 1rem;
    margin-top: 1rem;
}

.video-panel {
    grid-column: 1;
    grid-row: 1 / 3;
}

.script-panel {
    grid-column: 2;
    grid-row: 1;
}

.controls-panel {
    grid-column: 2;
    grid-row: 2;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
}

.ascii-panel {
    border: 1px solid #00FF41;
    padding: 0.5rem;
}

.panel-header {
    color: #00FF41;
    font-size: 0.75rem;
    margin: 0;
    padding: 0 0.25rem;
}

.output-video {
    border: 1px solid #00FF41;
    background: #000;
}

.ascii-btn {
    background: #000;
    color: #00FF41;
    border: 1px solid #00FF41;
    padding: 0.5rem;
    font-family: 'Courier New', monospace;
    cursor: pointer;
    font-size: 0.8rem;
    transition: all 0.2s;
}

.ascii-btn:hover {
    background: #00FF41;
    color: #000;
    text-shadow: none;
}

.ascii-btn:disabled {
    opacity: 0.5;
    cursor: not-allowed;
}

.wipe-btn {
    border-color: #FF4141;
    color: #FF4141;
    margin-top: 1rem;
}

.wipe-btn:hover {
    background: #FF4141;
    color: #000;
}

.error-box {
    color: #FF4141;
    border: 1px solid #FF4141;
    padding: 0.5rem;
    margin-top: 1rem;
}
</style>

@code {
    [Parameter] public Guid SessionId { get; set; }

    private bool _loading = true;
    private string? _error;
    private VideoSessionDto? _session;
    private DirectorScriptDto? _script;
    private string _scriptJson = "";
    private string? _statusMessage;

    protected override async Task OnInitializedAsync()
    {
        _loading = true;
        _error = null;

        try
        {
            // Play glitch transition — use absolute path so it resolves from wwwroot, not _framework/
            await JS.InvokeVoidAsync("eval", """
                (async function() {
                    const { playGlitchTransition } = await import('/js/glitch-transition.js');
                    await playGlitchTransition();
                })();
            """);

            // Load session data
            var sessionResponse = await Http.GetAsync($"/api/ingestion/sessions/{SessionId}");
            if (!sessionResponse.IsSuccessStatusCode)
            {
                _error = $"Failed to load session: HTTP {(int)sessionResponse.StatusCode}";
                return;
            }

            _session = await sessionResponse.Content.ReadFromJsonAsync<VideoSessionDto>();
            if (_session is null)
            {
                _error = "Session payload was empty.";
                return;
            }

            // Load director script
            try
            {
                var scriptResponse = await Http.GetAsync($"/api/output/sessions/{SessionId}/script");
                if (scriptResponse.IsSuccessStatusCode)
                {
                    _script = await scriptResponse.Content.ReadFromJsonAsync<DirectorScriptDto>();
                    if (_script is not null)
                    {
                        _scriptJson = System.Text.Json.JsonSerializer.Serialize(_script, new System.Text.Json.JsonSerializerOptions { WriteIndented = true });
                    }
                }
            }
            catch (Exception ex)
            {
                // Script may not be available yet; that's okay
                System.Diagnostics.Debug.WriteLine($"Script load error: {ex.Message}");
            }
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _loading = false;
        }
    }

    private async Task DownloadVideo()
    {
        if (_session?.OutputBlobPath is null)
        {
            _statusMessage = "Video not ready";
            return;
        }

        try
        {
            await JS.InvokeVoidAsync("eval", $"""
                window.location.href = '/api/output/sessions/{SessionId}/download/video';
            """);
            _statusMessage = "Video downloading...";
        }
        catch (Exception ex)
        {
            _statusMessage = $"Error: {ex.Message}";
        }
    }

    private async Task DownloadScript()
    {
        try
        {
            await JS.InvokeVoidAsync("eval", $"""
                window.location.href = '/api/output/sessions/{SessionId}/download/script';
            """);
            _statusMessage = "Script downloading...";
        }
        catch (Exception ex)
        {
            _statusMessage = $"Error: {ex.Message}";
        }
    }

    private async Task WipeBuffer()
    {
        _statusMessage = "Wiping buffer...";
        try
        {
            var response = await Http.DeleteAsync($"/api/output/sessions/{SessionId}");
            if (response.IsSuccessStatusCode)
            {
                Nav.NavigateTo("/");
            }
            else
            {
                _statusMessage = $"Wipe failed: HTTP {(int)response.StatusCode}";
            }
        }
        catch (Exception ex)
        {
            _statusMessage = $"Error: {ex.Message}";
        }
    }
}


