<div class="top-row ps-3 navbar navbar-dark">
    <div class="container-fluid">
        <a class="navbar-brand" href="/">PoMemeVideo</a>
        <button title="Navigation menu" class="navbar-toggler" @onclick="ToggleNavMenu">
            <span class="navbar-toggler-icon"></span>
        </button>
    </div>
</div>

<div class="@NavMenuCssClass nav-scrollable" @onclick:stopPropagation>
    <nav class="nav flex-column">
        <div class="nav-item px-3">
            <NavLink class="nav-link" href="/" Match="NavLinkMatch.All" @onclick="CollapseNav">
                <span class="bi bi-upload" aria-hidden="true"></span> Source
            </NavLink>
        </div>
        <div class="nav-item px-3">
            <NavLink class="nav-link" href="library" @onclick="CollapseNav">
                <span class="bi bi-collection-play" aria-hidden="true"></span> Library
            </NavLink>
        </div>
        <div class="nav-item px-3">
            <NavLink class="nav-link" href="results" @onclick="CollapseNav">
                <span class="bi bi-film" aria-hidden="true"></span> Results
            </NavLink>
        </div>
    </nav>

    @* ── Dev-only ANON login ─────────────────────────────────── *@
    @if (_isDevelopment)
    {
        <div class="anon-section px-3 mt-2">
            <button class="anon-btn" @onclick="LoginAnon" disabled="@_anonLoading">
                @(_anonLoading ? "[ ... ]" : "[ ANON LOGIN ]")
            </button>
            @if (_anonError is not null)
            {
                <pre class="ai-status ai-error">@_anonError</pre>
            }
        </div>
    }

    @* ── AI Model Selector ───────────────────────────────────── *@
    <div class="ai-panel px-3 mt-3">
        <pre class="ai-panel-title">[ DIRECTOR ENGINE ]</pre>

        @if (_loadingModel)
        {
            <pre class="ai-status">Loading...</pre>
        }
        else if (_loadError is not null)
        {
            <pre class="ai-status ai-error">⚠ @_loadError</pre>
        }
        else
        {
            <div class="ai-options">
                @* Azure OpenAI *@
                <label class="ai-option @(_pendingProvider == "AzureOpenAI" ? "selected" : "")"
                       @onclick='() => SelectProvider("AzureOpenAI", null)'>
                    <span class="ai-dot">@(_pendingProvider == "AzureOpenAI" ? "●" : "○")</span>
                    <span class="ai-label">Azure gpt-4o ☁</span>
                </label>

                @* Browser LLM via Transformers.js — always available, runs locally in-browser *@
                <label class="ai-option @(_pendingProvider == "BrowserLLM" ? "selected" : "")"
                       @onclick='() => SelectProvider("BrowserLLM", null)'>
                    <span class="ai-dot">@(_pendingProvider == "BrowserLLM" ? "●" : "○")</span>
                    <span class="ai-label">Local WebGPU Model ⚡</span>
                </label>
            </div>

            @if (_pendingProvider == "BrowserLLM")
            {
                <div class="ai-model-select-wrap">
                    @if (_localModels.Count > 0)
                    {
                        <label class="ai-model-label" for="local-model-select">Local model</label>
                        <select id="local-model-select" class="ai-model-select" @bind="_pendingBrowserLLMModel" @bind:after="OnPendingModelChanged">
                            @foreach (var localModel in _localModels)
                            {
                                <option value="@localModel.Id">@localModel.Label</option>
                            }
                        </select>
                    }
                    else
                    {
                        <pre class="ai-status ai-error">No local models found. Run: python tools/download-models.py</pre>
                    }
                </div>
            }

            @if (_isDirty)
            {
                <button class="ai-apply-btn" @onclick="ApplyModel" disabled="@_applying">
                    @(_applying ? "[ APPLYING... ]" : "[ APPLY ]")
                </button>
            }

            @if (_statusMessage is not null)
            {
                <pre class="ai-status @(_statusOk ? "ai-ok" : "ai-error")">@_statusMessage</pre>
            }
        }
    </div>
</div>

@code {
    private bool collapseNavMenu = true;
    private string? NavMenuCssClass => collapseNavMenu ? "collapse" : null;

    private void ToggleNavMenu() => collapseNavMenu = !collapseNavMenu;
    private void CollapseNav() => collapseNavMenu = true;

    // AI model state
    private bool _loadingModel = true;
    private string? _loadError;
    private bool _isDevelopment;
    private List<LocalModelInfo> _localModels = [];

    private string _activeProvider = "BrowserLLM";
    private string? _browserLLMModel;  // model id from server config
    private string _activeBrowserLLMModel = "smollm2-360m-instruct-onnx";

    private string _pendingProvider = "BrowserLLM";
    private string _pendingBrowserLLMModel = "smollm2-360m-instruct-onnx";

    private bool _isDirty;
    private bool _applying;
    private string? _statusMessage;
    private bool _statusOk;

    [Inject] private HttpClient Http { get; set; } = default!;
    [Inject] private IJSRuntime JS { get; set; } = default!;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var result = await Http.GetFromJsonAsync<AiModelResponse>("/api/config/ai-model");
            if (result is not null)
            {
                _activeProvider = result.Provider;
                _pendingProvider = result.Provider;
                _isDevelopment = result.IsDevelopment;
                _browserLLMModel = result.BrowserLLMModel;
                _localModels = result.LocalModels?.ToList() ?? [];
                _activeBrowserLLMModel = result.BrowserLLMModel ?? (_localModels.FirstOrDefault()?.Id ?? _activeBrowserLLMModel);
                _pendingBrowserLLMModel = _activeBrowserLLMModel;

                if (_localModels.Count > 0 && !_localModels.Any(m => m.Id == _pendingBrowserLLMModel))
                    _pendingBrowserLLMModel = _localModels[0].Id;

                if (_localModels.Count > 0 && !_localModels.Any(m => m.Id == _activeBrowserLLMModel))
                    _activeBrowserLLMModel = _localModels[0].Id;

                // Warm up the browser model in the background if it is selected
                if (result.Provider == "BrowserLLM" && _localModels.Count > 0)
                    _ = JS.InvokeVoidAsync("browserLLM.warmup", _activeBrowserLLMModel);
            }
        }
        catch (Exception ex)
        {
            _loadError = ex.Message.Length > 40 ? ex.Message[..40] + "…" : ex.Message;
        }
        finally
        {
            _loadingModel = false;
        }
    }

    private void SelectProvider(string provider, string? model)
    {
        _pendingProvider = provider;
        if (model is not null)
            _pendingBrowserLLMModel = model;
        RecomputeDirtyState();
        _statusMessage = null;
    }

    private void OnPendingModelChanged()
    {
        RecomputeDirtyState();
        _statusMessage = null;
    }

    private void RecomputeDirtyState()
    {
        _isDirty = _pendingProvider != _activeProvider
                   || _pendingBrowserLLMModel != _activeBrowserLLMModel;
    }

    private async Task ApplyModel()
    {
        _applying = true;
        _statusMessage = null;
        StateHasChanged();
        try
        {
            var body = new { provider = _pendingProvider, browserLLMModel = _pendingBrowserLLMModel };
            var resp = await Http.PutAsJsonAsync("/api/config/ai-model", body);
            if (resp.IsSuccessStatusCode)
            {
                _activeProvider = _pendingProvider;
                _activeBrowserLLMModel = _pendingBrowserLLMModel;
                _isDirty = false;
                _statusMessage = "✓ Switched";
                _statusOk = true;

                if (_activeProvider == "BrowserLLM")
                    _ = JS.InvokeVoidAsync("browserLLM.warmup", _activeBrowserLLMModel);
            }
            else
            {
                _statusMessage = $"Error {(int)resp.StatusCode}";
                _statusOk = false;
            }
        }
        catch (Exception ex)
        {
            _statusMessage = ex.Message.Length > 35 ? ex.Message[..35] + "…" : ex.Message;
            _statusOk = false;
        }
        finally
        {
            _applying = false;
        }
    }

    private bool _anonLoading;
    private string? _anonError;

    private async Task LoginAnon()
    {
        _anonLoading = true;
        _anonError = null;
        try
        {
            var resp = await Http.PostAsync("/auth/anon", null);
            if (!resp.IsSuccessStatusCode)
                _anonError = $"ANON login not yet implemented (HTTP {(int)resp.StatusCode}).";
        }
        catch (Exception ex)
        {
            _anonError = ex.Message.Length > 40 ? ex.Message[..40] + "…" : ex.Message;
        }
        finally
        {
            _anonLoading = false;
        }
    }

    private sealed record AiModelResponse(
        string Provider,
        string? BrowserLLMModel,
        LocalModelInfo[]? LocalModels,
        bool IsDevelopment);

    private sealed record LocalModelInfo(string Id, string Label);
}

