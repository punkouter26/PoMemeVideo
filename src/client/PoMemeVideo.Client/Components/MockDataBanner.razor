@implements IAsyncDisposable
@inject HttpClient Http

<div class="mock-banner" @onclick="Dismiss" style="@(_visible ? "" : "display:none")">
    <pre>⚠ MOCK DATA MODE ACTIVE — RESULTS ARE SYNTHETIC ⚠  [click to dismiss]</pre>
</div>

<style>
.mock-banner {
    background: #FF4100;
    color: #000;
    font-family: 'Courier New', monospace;
    font-weight: bold;
    font-size: 0.9rem;
    text-align: center;
    padding: 0.4rem;
    cursor: pointer;
    animation: flash 1s step-start infinite;
}
@@keyframes flash {
    50% { background: #FF8C00; }
}
</style>

@code {
    private bool _visible;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var response = await Http.GetFromJsonAsync<ConfigResponse>("/api/config");
            _visible = response?.UseMockAi ?? false;
        }
        catch
        {
            _visible = false;
        }
    }

    private void Dismiss() => _visible = false;

    public ValueTask DisposeAsync() => ValueTask.CompletedTask;

    private sealed record ConfigResponse(bool UseMockAi, bool IsDevelopment);
}
