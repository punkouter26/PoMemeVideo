@implements IDisposable

<div class="ascii-panel hardware-monitor">
    <pre class="panel-header">╔═══════════════════════════════════╗
║  HARDWARE MONITOR  ▓             ║
╚═══════════════════════════════════╝</pre>
    <div class="hw-metrics">
        <div class="metric-row">
            <span class="metric-label">INFERENCE  </span>
            <span class="metric-bar">@RenderBar(_latencyMs, 300.0)</span>
            <span class="metric-value"> @_latencyMs.ToString("F0")ms</span>
        </div>
        <div class="metric-row">
            <span class="metric-label">CPU LOAD   </span>
            <span class="metric-bar">@RenderBar(_cpuLoad, 100.0)</span>
            <span class="metric-value"> @_cpuLoad.ToString("F0")%</span>
        </div>
    </div>
</div>

<style>
.hardware-monitor {
    font-family: 'Courier New', monospace;
    background: #000;
    color: #00FF41;
}
.hw-metrics {
    padding: 0.5rem;
}
.metric-row {
    display: flex;
    align-items: center;
    margin-bottom: 0.4rem;
    font-size: 0.85rem;
    white-space: nowrap;
}
.metric-label {
    color: #00FF41;
    width: 10ch;
}
.metric-bar {
    color: #00FF41;
}
.metric-value {
    color: #00FF41;
    min-width: 6ch;
    text-align: right;
}
</style>

@code {
    [Parameter, EditorRequired] public EngineHubClient HubClient { get; set; } = null!;

    private double _latencyMs;
    private double _cpuLoad;

    protected override void OnInitialized()
    {
        HubClient.HardwareMetrics += OnMetrics;
    }

    private void OnMetrics(double latencyMs, double cpuLoad)
    {
        _latencyMs = latencyMs;
        _cpuLoad = cpuLoad;
        InvokeAsync(StateHasChanged);
    }

    private static string RenderBar(double value, double max)
    {
        const int barWidth = 16;
        var filled = (int)Math.Round(value / max * barWidth);
        filled = Math.Clamp(filled, 0, barWidth);
        return "[" + new string('█', filled) + new string('░', barWidth - filled) + "]";
    }

    public void Dispose()
    {
        HubClient.HardwareMetrics -= OnMetrics;
    }
}
