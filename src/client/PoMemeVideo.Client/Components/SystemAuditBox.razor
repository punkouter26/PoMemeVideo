@implements IDisposable

<div class="ascii-panel">
    <pre class="panel-header">╔═══════════════════════════════════╗
║  SYSTEM AUDIT  ▓                 ║
╚═══════════════════════════════════╝</pre>
    <div class="audit-feed">
        @foreach (var line in _lines)
        {
            <div class="audit-line @GetLineClass(line)">@line</div>
        }
    </div>
</div>

<style>
.audit-feed {
    height: 180px;
    overflow-y: auto;
    background: #000;
    padding: 0.5rem;
    font-family: 'Courier New', monospace;
    font-size: 0.8rem;
}
.audit-line {
    color: #00FF41;
    margin-bottom: 2px;
}
.audit-line.conflict {
    color: #FF4141;
}
.audit-line.fallback {
    color: #FFFF41;
}
</style>

@code {
    [Parameter, EditorRequired] public EngineHubClient HubClient { get; set; } = null!;

    private readonly List<string> _lines = new();

    protected override void OnInitialized()
    {
        HubClient.AuditEntry += OnAudit;
    }

    private void OnAudit(string message)
    {
        _lines.Add(message);
        InvokeAsync(StateHasChanged);
    }

    private static string GetLineClass(string line)
    {
        if (line.Contains("[CONFLICT]")) return "conflict";
        if (line.Contains("[FALLBACK]")) return "fallback";
        return string.Empty;
    }

    public void Dispose()
    {
        HubClient.AuditEntry -= OnAudit;
    }
}
