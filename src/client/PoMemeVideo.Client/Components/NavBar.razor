@* NavBar.razor
   Retro-terminal styled navigation bar displayed on all pages via MainLayout.
   Reads auth identity from GET /api/auth/me and displays:
     - "ANON LOGGED IN" for ANON identities (ANON\d{6})
     - User email for Microsoft OAuth authenticated users
     - "[ GUEST ]" when no session is active
   Styled with retro-terminal.css ASCII horizontal rule separator. *@
@inject HttpClient Http
@inject NavigationManager Nav
@implements IDisposable

<nav class="retro-navbar" role="navigation" aria-label="Site navigation">
    <a class="brand flicker" href="/">PoMemeVideo</a>

    <div class="nav-links">
        <a href="/">[ SOURCE ]</a>
        <a href="/library">[ LIBRARY ]</a>
        <a href="/results">[ RESULTS ]</a>
        <a href="http://localhost:8000/scalar/" target="_blank" rel="noopener noreferrer">[ API ]</a>
    </div>

    <span class="auth-status">
        @if (_authDisplay is not null)
        {
            @_authDisplay
        }
        else
        {
            <span style="opacity:0.4;">[ GUEST ]</span>
        }
    </span>
</nav>
<hr class="retro-navbar-divider" />

@code {
    private string? _authDisplay;
    private System.Threading.Timer? _refreshTimer;

    protected override async Task OnInitializedAsync()
    {
        await LoadAuthAsync();
        // Refresh auth state every 30 seconds to pick up logins/logouts.
        _refreshTimer = new System.Threading.Timer(
            async _ =>
            {
                await LoadAuthAsync();
                await InvokeAsync(StateHasChanged);
            },
            null,
            TimeSpan.FromSeconds(30),
            TimeSpan.FromSeconds(30));
    }

    private async Task LoadAuthAsync()
    {
        try
        {
            var me = await Http.GetFromJsonAsync<AuthMeResponse>("/api/auth/me");
            if (me?.DisplayName is { Length: > 0 } name)
            {
                // ANON\d{6} pattern — show ANON LOGGED IN
                if (System.Text.RegularExpressions.Regex.IsMatch(name, @"^ANON\d{6}$"))
                    _authDisplay = $"[ ANON LOGGED IN : {name} ]";
                else
                    _authDisplay = $"[ {name} ]";
            }
            else
            {
                _authDisplay = null;
            }
        }
        catch
        {
            // Auth endpoint not available — show guest silently.
            _authDisplay = null;
        }
    }

    public void Dispose() => _refreshTimer?.Dispose();

    private sealed record AuthMeResponse(string? DisplayName, string? Email);
}
