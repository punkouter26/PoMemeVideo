@* NavBar.razor
   Retro-terminal styled navigation bar displayed on all pages via MainLayout.
   Reads auth identity from GET /api/auth/me and displays:
     - "ANON LOGGED IN" for ANON identities (ANON\d{6})
     - User email for Microsoft OAuth authenticated users
     - "[ GUEST ]" when no session is active
   Styled with retro-terminal.css ASCII horizontal rule separator. *@
@inject HttpClient Http
@inject NavigationManager Nav
@implements IDisposable

<nav class="retro-navbar" role="navigation" aria-label="Site navigation">
    <NavLink class="brand flicker" href="/" Match="NavLinkMatch.All">PoMemeVideo</NavLink>

    <div class="nav-links">
        <NavLink href="/" Match="NavLinkMatch.All">[ CREATE ]</NavLink>
        <NavLink href="/admin/sounds">[ SOUNDS ]</NavLink>
        <NavLink href="/results">[ HISTORY ]</NavLink>
        <a href="/scalar/" target="_blank" rel="noopener noreferrer" style="opacity:0.55; font-size:0.72rem;">[ API ]</a>
    </div>

    <div class="status-cluster" aria-label="Runtime status">
        <span class="auth-status">
            @if (_authDisplay is not null)
            {
                @_authDisplay
            }
            else
            {
                <span style="opacity:0.4;">[ GUEST ]</span>
            }
        </span>

        <span class="auth-status">
            @if (_aiDisplay is not null)
            {
                @_aiDisplay
            }
            else
            {
                <span style="opacity:0.4;">[ AI: UNKNOWN ]</span>
            }
        </span>
    </div>
</nav>
<hr class="retro-navbar-divider" />

@code {
    private string? _authDisplay;
    private string? _aiDisplay;
    private System.Threading.Timer? _refreshTimer;

    protected override async Task OnInitializedAsync()
    {
        await LoadAuthAsync();
        await LoadAiAsync();
        // Refresh auth state every 30 seconds to pick up logins/logouts.
        _refreshTimer = new System.Threading.Timer(
            async _ =>
            {
                await LoadAuthAsync();
                await LoadAiAsync();
                await InvokeAsync(StateHasChanged);
            },
            null,
            TimeSpan.FromSeconds(30),
            TimeSpan.FromSeconds(30));
    }

    private async Task LoadAiAsync()
    {
        try
        {
            var ai = await Http.GetFromJsonAsync<AiModelResponse>("/api/config/ai-model");
            if (ai is null)
            {
                _aiDisplay = null;
                return;
            }

            if (ai.Provider == "AzureOpenAI")
            {
                _aiDisplay = "[ AI: OPENAI ]";
                return;
            }

            var selected = ai.LocalModels?.FirstOrDefault(m => m.Id == ai.BrowserLLMModel)?.Label
                           ?? ai.BrowserLLMModel
                           ?? "LOCAL";
            _aiDisplay = $"[ AI: {selected.ToUpperInvariant()} ]";
        }
        catch
        {
            _aiDisplay = null;
        }
    }

    private async Task LoadAuthAsync()
    {
        try
        {
            var me = await Http.GetFromJsonAsync<AuthMeResponse>("/api/auth/me");
            if (me?.DisplayName is { Length: > 0 } name)
            {
                // ANON\d{6} pattern — show ANON LOGGED IN
                if (System.Text.RegularExpressions.Regex.IsMatch(name, @"^ANON\d{6}$"))
                    _authDisplay = "[ ANON LOGGED IN ]";
                else
                    _authDisplay = $"[ {me.Email ?? name} ]";
            }
            else
            {
                _authDisplay = null;
            }
        }
        catch
        {
            // Auth endpoint not available — show guest silently.
            _authDisplay = null;
        }
    }

    public void Dispose() => _refreshTimer?.Dispose();

    private sealed record AuthMeResponse(string? DisplayName, string? Email);
    private sealed record AiModelResponse(string Provider, string? BrowserLLMModel, LocalModelInfo[]? LocalModels);
    private sealed record LocalModelInfo(string Id, string Label);
}
