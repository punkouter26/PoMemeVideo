{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "AzureTableStorage": "",
    "AzureBlobStorage": ""
  },
  "AzureAiVision": {
    "Endpoint": ""
  },
  "AzureOpenAI": {
    "Endpoint": ""
  },
  "AzureAd": {
    "Instance": "https://login.microsoftonline.com/",
    "TenantId": "",
    "ClientId": "",
    "CallbackPath": "/auth/callback"
  },
  "ApplicationInsights": {
    "ConnectionString": ""
  },
  "UseMockAI": false,
  "FeatureFlags": {
    "EnableAzureAiVision": true,
    "EnableAzureOpenAI": true
  },
  "Serilog": {
    "Using": [
      "Serilog.Sinks.Console"
    ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.AspNetCore": "Warning",
        "System": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Console"
      }
    ],
    "Enrich": [
      "FromLogContext"
    ],
    "Properties": {
      "Application": "PoMemeVideo"
    }
  }
}
