@page
@model PoMemeVideo.Api.Pages.DiagModel
@{
    ViewData["Title"] = "Diagnostics";
    Layout = null;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8" />
    <title>PoMemeVideo — Diagnostics</title>
    <style>
        body { background: #000; color: #00FF41; font-family: 'Courier New', monospace; padding: 2rem; }
        table { border-collapse: collapse; width: 100%; }
        th, td { border: 1px solid #00FF41; padding: 0.5rem 1rem; text-align: left; }
        th { color: #fff; }
        .ok { color: #00FF41; }
        .degraded { color: #FF4141; }
    </style>
</head>
<body>
    <pre>
╔══════════════════════════════════════════╗
║    POMEMEVIDEO :: DIAGNOSTIC PANEL       ║
╚══════════════════════════════════════════╝
    </pre>
    <h2>External Connection Status</h2>
    <table>
        <thead>
            <tr><th>Service</th><th>Status</th></tr>
        </thead>
        <tbody>
            @foreach (var check in Model.ConnectionChecks)
            {
                <tr>
                    <td>@check.Name</td>
                    <td class="@(check.IsHealthy ? "ok" : "degraded")">@check.Status</td>
                </tr>
            }
        </tbody>
    </table>

    <h2>Configuration Keys</h2>
    <table>
        <thead>
            <tr><th>Key</th><th>Value</th></tr>
        </thead>
        <tbody>
            @foreach (var entry in Model.ConfigEntries)
            {
                <tr>
                    <td>@entry.Key</td>
                    <td>@entry.MaskedValue</td>
                </tr>
            }
        </tbody>
    </table>
</body>
</html>
