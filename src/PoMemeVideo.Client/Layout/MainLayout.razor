@inherits LayoutComponentBase
@using PoMemeVideo.Client.Components

<div class="po-app-viewport">
    <NavBar />
    <MockDataBanner />
    @* First tab stop skips the nav straight to the page's own content. *@
    <a class="skip-link" href="#main-content">Skip to main content</a>

    <main id="main-content" class="po-main-stage" tabindex="-1">
        <ErrorBoundary>
            <ChildContent>
                @Body
            </ChildContent>
            <ErrorContent>
                <div class="po-error-panel" role="alert">
                    <h2>Something went wrong</h2>
                    <p>This page hit an unexpected error. Reload the page to try again.</p>
                </div>
            </ErrorContent>
        </ErrorBoundary>
    </main>
</div>
