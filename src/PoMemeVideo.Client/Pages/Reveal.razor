@page "/reveal/{SessionId:guid}"
@inject HttpClient Http
@inject IJSRuntime JS
@inject NavigationManager Nav
@inject Vibe3DService Vibe3D
@inject NotificationService Notification
@using PoMemeVideo.Shared.Models
@using PoMemeVideo.Shared.Enums
@using PoMemeVideo.Client.Components
@using Radzen
@using Radzen.Blazor
@implements IAsyncDisposable

<PageTitle>PoMemeVideo — Review &amp; Studio</PageTitle>

<div class="reveal-page">
    <MockDataBanner />

    @if (_showCompleteFlash)
    {
        <div class="render-complete-flash reveal-in">
            <pre>[ ✓ RENDER COMPLETE — YOUR MEME VIDEO IS READY ]</pre>
        </div>
    }

    <div class="page-hero">
        <h1 class="hero-title">Review &amp; Cue Studio</h1>
        <p class="hero-sub">Session: @SessionId</p>
    </div>

    @if (_loading)
    {
        <div class="loading-wrap ascii-border-double">
            <RadzenProgressBar Value="100" ShowValue="false" Mode="ProgressBarMode.Indeterminate" Style="height: 6px;" />
            <pre class="reveal-loading">[ Loading video session &amp; director script… ]</pre>
        </div>
    }
    else if (!string.IsNullOrWhiteSpace(_error))
    {
        <pre class="error-box">[ ERROR ] @_error</pre>
    }
    else if (_session is not null)
    {
        <div class="reveal-grid">
            <!-- Video Player -->
            <div class="video-panel">
                @if (!string.IsNullOrWhiteSpace(_session.OutputBlobPath))
                {
                    <div class="ascii-border-double vibe-3d-stage vibe-glass-card">
                        <pre class="panel-header">[ OUTPUT VIDEO ]</pre>
                        @*
                          The <video> sits OUTSIDE the CrtMonitorFrame. When Chromium wraps a
                          <video> in any ancestor with `filter: url(#...)`, it silently drops
                          the audio track (webkitAudioDecodedByteCount stays at 0;
                          captureStream() returns no audio tracks) — the user sees video but
                          hears nothing. The decorative CRT bulge is applied to a sibling
                          overlay layer instead so the video keeps full audio playback.
                        *@
                        <div class="video-crt-wrap">
                            <video id="reveal-output-video" class="output-video" controls playsinline @onloadedmetadata="OnVideoLoaded" @onerror="OnVideoError">
                                <source src="/api/output/sessions/@SessionId/stream/video" type="video/mp4" />
                                Your browser does not support the video tag.
                            </video>
                            <div class="video-crt-overlay" aria-hidden="true">
                                <CrtMonitorFrame>
                                    <div class="video-crt-overlay-inner"></div>
                                </CrtMonitorFrame>
                            </div>
                        </div>

                        <div class="reveal-meta">
                            <pre> STATUS     : @_session.Status</pre>
                            <pre> DURATION   : @_session.VideoDurationSeconds.ToString("F1")s</pre>
                            <pre> GENERATED  : @(_session.CompletedAt?.ToLocalTime().ToString("yyyy-MM-dd HH:mm:ss") ?? "PENDING")</pre>
                            <pre> SOUNDS     : @(_script?.TotalSoundCount ?? 0)</pre>
                        </div>

                        @if (_videoLoadFailed)
                        {
                            <div class="video-fallback-box">
                                <pre>[ PLAYER FALLBACK ] Inline playback failed in this browser.</pre>
                                <a class="ascii-btn" href="/api/output/sessions/@SessionId/stream/video" target="_blank" rel="noopener noreferrer">[ OPEN DIRECT STREAM ]</a>
                            </div>
                        }
                    </div>
                }
                else
                {
                    <pre class="output-not-ready">[ OUTPUT NOT READY ]</pre>
                }
            </div>

            <!-- Director Script Panel -->
            <div class="script-panel-reveal ascii-border-double vibe-3d-stage vibe-glass-card">
                <div class="script-header-row">
                    <pre class="panel-header">[ AI DIRECTOR'S SCRIPT ]</pre>
                    <button class="ascii-btn compact-btn @(_editMode ? "active" : "")" @onclick="() => _editMode = !_editMode">
                        @(_editMode ? "[ 💾 SAVE / VIEW ]" : "[ ✏️ EDIT CUES ]")
                    </button>
                </div>
                <p class="reveal-script-subtitle">What was added to your video and why — fine-tune timing below</p>

                @if (_script is not null && _script.Entries.Count > 0)
                {
                    <div class="script-scroll">
                        @foreach (var (entry, idx) in _script.Entries.Select((e, i) => (e, i + 1)))
                        {
                            <div class="cut-block ascii-border-double">
                                <div class="cut-header-bar">
                                    <span class="cut-title">CUT @idx</span>
                                    @if (_editMode)
                                    {
                                        <div class="cut-edit-timing">
                                            <span class="edit-label">TIMESTAMP (ms):</span>
                                            <RadzenNumeric TValue="long"
                                                           Value="@GetTiming(idx, entry.TimestampMs)"
                                                           Change="@(val => SetTiming(idx, val))"
                                                           Min="0" Step="100" Style="width: 110px;" />
                                        </div>
                                    }
                                    else
                                    {
                                        <span class="cut-time">@((GetTiming(idx, entry.TimestampMs) / 1000.0).ToString("F1"))s</span>
                                    }
                                </div>

                                <div class="cut-details">
                                    <div class="cut-row"><span class="cut-k">SCENE:</span> <span class="cut-v">@(string.IsNullOrWhiteSpace(entry.SceneDescription) ? "—" : entry.SceneDescription)</span></div>
                                    <div class="cut-sound-row">
                                        <span class="cut-k">SOUND:</span>
                                        <span class="cut-v sound-name">@(string.IsNullOrWhiteSpace(entry.SoundName) ? entry.SoundId.ToString()[..8] + "…" : entry.SoundName)</span>
                                        <audio id="reveal-audio-@entry.SoundId-@idx" src="/api/memelibrary/sounds/@entry.SoundId/stream" preload="none"></audio>
                                        <button class="ascii-btn compact-btn reveal-play-btn"
                                                onclick="(function(btn){
                                                    var audio = document.getElementById('reveal-audio-@entry.SoundId-@idx');
                                                    if (!audio.paused) { audio.pause(); audio.currentTime = 0; btn.textContent = '[ ▶ ]'; return; }
                                                    document.querySelectorAll('audio').forEach(function(a){ a.pause(); a.currentTime = 0; });
                                                    document.querySelectorAll('.reveal-play-btn').forEach(function(b){ b.textContent = '[ ▶ ]'; });
                                                    audio.play();
                                                    btn.textContent = '[ ■ ]';
                                                    audio.onended = function(){ btn.textContent = '[ ▶ ]'; };
                                                })(this)">[ &#9654; PLAY ]</button>
                                    </div>
                                    <div class="cut-row"><span class="cut-k">WHY:</span> <span class="cut-v">@(string.IsNullOrWhiteSpace(entry.SelectionRationale) ? "—" : entry.SelectionRationale)</span></div>
                                    <div class="cut-row"><span class="cut-k">EFFECT:</span> <span class="cut-v">@(entry.VisualEffect?.ToString() ?? "None") · IRONIC: @(entry.IsIronic ? "YES" : "NO") · @entry.PlacementType</span></div>
                                </div>
                            </div>
                        }
                    </div>
                }
                else if (_script is not null)
                {
                    <pre class="script-empty">[ No script entries generated for this session ]</pre>
                }
                else if (!string.IsNullOrWhiteSpace(_scriptStatusMessage))
                {
                    <pre class="script-status">@_scriptStatusMessage</pre>
                }
            </div>

            <!-- Actions Panel -->
            <div class="controls-panel">
                <div class="reveal-actions-primary">
                    <button class="ascii-btn download-btn" @onclick="DownloadVideo">[ ⬇ Download Video ]</button>
                    <button class="ascii-btn compact-btn" @onclick="DownloadScript">[ Download Script ]</button>
                    <button class="ascii-btn compact-btn" @onclick="ShareVideo">[ 📤 Share Video ]</button>
                    <button class="ascii-btn compact-btn" @onclick="ToggleRawJson">[ @(_showJson ? "Hide JSON" : "Show JSON") ]</button>
                </div>
                <div class="reveal-actions-secondary">
                    <button class="ascii-btn compact-btn" @onclick='() => Nav.NavigateTo("/results")'>[ View History ]</button>
                    <button class="ascii-btn compact-btn" @onclick='() => Nav.NavigateTo("/")'>[ + Create Another ]</button>
                </div>
            </div>

            @if (_showJson && !string.IsNullOrWhiteSpace(_scriptJson))
            {
                <div class="json-panel ascii-border-double reveal-in vibe-glass-card">
                    <pre class="panel-header">[ RAW DIRECTOR SCRIPT JSON ]</pre>
                    <pre class="json-content">@_scriptJson</pre>
                </div>
            }
        </div>
    }
</div>

@code {
    [Parameter]
    public Guid SessionId { get; set; }

    private VideoSessionDto? _session;
    private DirectorScriptDto? _script;
    private bool _loading = true;
    private string? _error;
    private string? _scriptStatusMessage;
    private string? _scriptJson;
    private bool _showJson;
    private bool _editMode;
    private bool _showCompleteFlash;
    private bool _videoLoadFailed;
    private IJSObjectReference? _revealJs;
    private readonly Dictionary<int, long> _editedTimings = [];

    protected override async Task OnInitializedAsync()
    {
        await LoadSessionAsync();
    }

    private long GetTiming(int idx, long defaultVal) =>
        _editedTimings.TryGetValue(idx, out var val) ? val : defaultVal;

    private void SetTiming(int idx, long val) => _editedTimings[idx] = val;

    private void ToggleRawJson() => _showJson = !_showJson;

    private async Task LoadSessionAsync()
    {
        _loading = true;
        _error = null;

        try
        {
            _revealJs = await JS.InvokeAsync<IJSObjectReference>("import", "/js/reveal.js");
            await _revealJs.InvokeVoidAsync("playTransition");

            var sessionResponse = await Http.GetAsync($"/api/ingestion/sessions/{SessionId}");
            if (!sessionResponse.IsSuccessStatusCode)
            {
                _error = $"Failed to load session: HTTP {(int)sessionResponse.StatusCode}";
                return;
            }

            _session = await sessionResponse.Content.ReadFromJsonAsync<VideoSessionDto>();
            if (_session is null)
            {
                _error = "Session payload was empty.";
                return;
            }

            try
            {
                var scriptResponse = await Http.GetAsync($"/api/output/sessions/{SessionId}/script");
                if (scriptResponse.IsSuccessStatusCode)
                {
                    _script = await scriptResponse.Content.ReadFromJsonAsync<DirectorScriptDto>();
                    if (_script is not null)
                    {
                        _scriptJson = System.Text.Json.JsonSerializer.Serialize(_script, new System.Text.Json.JsonSerializerOptions { WriteIndented = true });
                    }
                }
                else
                {
                    _scriptStatusMessage = $"[ SCRIPT STATUS ] HTTP {(int)scriptResponse.StatusCode} while loading script.";
                }
            }
            catch (Exception ex)
            {
                _scriptStatusMessage = $"[ SCRIPT STATUS ] {ex.Message}";
            }
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _loading = false;
            if (_session?.Status == SessionStatus.Complete)
            {
                _showCompleteFlash = true;
                _ = Vibe3D.SetAuroraStateAsync("complete");
                _ = Vibe3D.TriggerCelebrationBurstAsync();
                Notification.Notify(NotificationSeverity.Success, "Render Complete", "Your meme video is ready for playback & download!", 4000);
                _ = Task.Delay(3500).ContinueWith(_ => InvokeAsync(() =>
                {
                    _showCompleteFlash = false;
                    StateHasChanged();
                }));
            }
        }
    }

    private async Task DownloadVideo()
    {
        if (_session?.OutputBlobPath is null)
        {
            Notification.Notify(NotificationSeverity.Warning, "Download", "Video is not ready yet.", 2500);
            return;
        }

        try
        {
            var downloadUrl = $"/api/output/sessions/{SessionId}/download";
            var fileName = $"pomemevideo_{SessionId:N}.mp4";
            await JS.InvokeVoidAsync("eval", $@"
                (function() {{
                    var a = document.createElement('a');
                    a.href = '{downloadUrl}';
                    a.download = '{fileName}';
                    document.body.appendChild(a);
                    a.click();
                    document.body.removeChild(a);
                }})();
            ");
            Notification.Notify(NotificationSeverity.Success, "Download Started", fileName, 3000);
        }
        catch (Exception ex)
        {
            Notification.Notify(NotificationSeverity.Error, "Download Failed", ex.Message, 4000);
        }
    }

    private async Task DownloadScript()
    {
        if (_scriptJson is null) return;
        var bytes = System.Text.Encoding.UTF8.GetBytes(_scriptJson);
        var base64 = Convert.ToBase64String(bytes);
        var fileName = $"script_{SessionId:N}.json";
        await JS.InvokeVoidAsync("eval", $@"
            (function() {{
                var a = document.createElement('a');
                a.href = 'data:application/json;base64,{base64}';
                a.download = '{fileName}';
                document.body.appendChild(a);
                a.click();
                document.body.removeChild(a);
            }})();
        ");
        Notification.Notify(NotificationSeverity.Info, "Script Downloaded", fileName, 2500);
    }

    private async Task ShareVideo()
    {
        var shareUrl = Nav.Uri;
        var shareText = "Check out my AI Meme Video on PoMemeVideo!";
        try
        {
            await JS.InvokeVoidAsync("eval", $@"
                (async function() {{
                    if (navigator.share) {{
                        try {{
                            await navigator.share({{
                                title: 'PoMemeVideo Review',
                                text: '{shareText}',
                                url: '{shareUrl}'
                            }});
                        }} catch (e) {{}}
                    }} else if (navigator.clipboard) {{
                        await navigator.clipboard.writeText('{shareUrl}');
                    }}
                }})();
            ");
            Notification.Notify(NotificationSeverity.Success, "Share Ready", "Video link copied to clipboard!", 2500);
        }
        catch (Exception ex)
        {
            Notification.Notify(NotificationSeverity.Info, "Share", ex.Message, 2500);
        }
    }

    private void OnVideoLoaded() => _videoLoadFailed = false;
    private void OnVideoError() => _videoLoadFailed = true;

    public async ValueTask DisposeAsync()
    {
        if (_revealJs is not null)
        {
            try { await _revealJs.DisposeAsync(); } catch { }
        }
    }
}