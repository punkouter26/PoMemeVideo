@page "/not-found"
@layout MainLayout
@inject NavigationManager Nav

<PageTitle>404 — SECTOR NOT FOUND | PoMemeVideo</PageTitle>

<div class="terminal-stage reveal-in notfound-stage">
    <div class="ascii-border-double notfound-panel">
        <pre class="term-dim notfound-figlet">
  ____ ___  _  _     _  _  ___ _____   _____ ___  _   _ _   _ ____  
 |___ / _ \| || |   | \| |/ _ \_   _| |  ___/ _ \| | | | \ | |  _ \ 
   |_ \ | | | || |_ | .\ | | | || |   | |_ | | | | | | |  \| | | | |
  ___) | |_| |__   _|| |\  |_| || |   |  _|| |_| | |_| | |\  | |_| |
 |____/ \___/   |_|  |_| \_\___/ |_|   |_|   \___/ \___/|_| \_|____/ 
        </pre>

        <h2 class="notfound-heading">
            [ ERROR 404: TARGET SECTOR NOT FOUND ]
        </h2>

        <p class="term-dim notfound-body">
            The requested resource, sequence coordinate, or session artifact does not exist in the active terminal directory.
        </p>

        <button class="ascii-btn primary-action notfound-home-btn" @onclick="GoHome">
            [ 🏠 RETURN TO MAIN TERMINAL ]
        </button>
    </div>
</div>

@code {
    private void GoHome()
    {
        Nav.NavigateTo("/");
    }
}