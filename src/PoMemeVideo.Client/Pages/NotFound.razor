@page "/not-found"
@layout MainLayout
@inject NavigationManager Nav

<PageTitle>404 — SECTOR NOT FOUND | PoMemeVideo</PageTitle>

<div class="terminal-stage reveal-in" style="max-width: 680px; margin: 3rem auto; padding: 1.5rem;">
    <div class="ascii-border-double" style="padding: 2rem; background: rgba(5, 12, 8, 0.9); text-align: center;">
        <pre class="term-dim" style="font-size: 0.75rem; line-height: 1.2; color: var(--term-danger, #ff5f5f); margin-bottom: 1.5rem;">
  ____ ___  _  _     _  _  ___ _____   _____ ___  _   _ _   _ ____  
 |___ / _ \| || |   | \| |/ _ \_   _| |  ___/ _ \| | | | \ | |  _ \ 
   |_ \ | | | || |_ | .\ | | | || |   | |_ | | | | | | |  \| | | | |
  ___) | |_| |__   _|| |\  |_| || |   |  _|| |_| | |_| | |\  | |_| |
 |____/ \___/   |_|  |_| \_\___/ |_|   |_|   \___/ \___/|_| \_|____/ 
        </pre>

        <h2 style="color: var(--term-danger, #ff5f5f); font-size: 1.25rem; margin-bottom: 0.75rem;">
            [ ERROR 404: TARGET SECTOR NOT FOUND ]
        </h2>

        <p class="term-dim" style="font-size: 0.9rem; line-height: 1.6; margin-bottom: 1.75rem;">
            The requested resource, sequence coordinate, or session artifact does not exist in the active terminal directory.
        </p>

        <button class="ascii-btn primary-action" @onclick="GoHome" style="font-size: 0.95rem; padding: 0.6rem 1.5rem;">
            [ 🏠 RETURN TO MAIN TERMINAL ]
        </button>
    </div>
</div>

@code {
    private void GoHome()
    {
        Nav.NavigateTo("/");
    }
}