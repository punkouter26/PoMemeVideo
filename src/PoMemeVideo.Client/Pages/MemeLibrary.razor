@page "/memelibrary"
@page "/library"
@inject HttpClient Http
@inject NavigationManager Nav
@inject IJSRuntime JS
@using Microsoft.AspNetCore.Components.Forms
@using PoMemeVideo.Shared.Models
@implements IDisposable

<PageTitle>PoMemeVideo — Sound Library</PageTitle>

<div class="library-viewport">
    <div class="library-header-row">
        <div class="library-title-group">
            <h1 class="hero-title">Sound Library</h1>
            <span class="hero-sub">Browse, audition, and filter the meme audio catalog</span>
        </div>

        <div class="library-toolbar">
            <input class="ascii-input library-search-input"
                   placeholder="Search name or keywords…"
                   @bind="SearchQuery"
                   @bind:event="oninput" />
            <input class="ascii-input library-tag-input"
                   placeholder="Filter tags (e.g. vine, boom)…"
                   @bind="TagFilter"
                   @bind:event="oninput" />
            <button class="ascii-btn compact-btn" @onclick="ClearFilters" disabled="@_loading">[ Clear ]</button>
            <button class="ascii-btn compact-btn @(_showDspRack ? "is-active" : "")" @onclick="() => _showDspRack = !_showDspRack">
                @(_showDspRack ? "[ 🎛️ Hide DSP ]" : "[ 🎛️ Audio DSP ]")
            </button>
            <button class="ascii-btn compact-btn is-cyan" @onclick="ToggleUploadModal">
                @(_showUploadModal ? "[ ✕ Close ]" : "[ ⬆ Upload ]")
            </button>
        </div>
    </div>

    @if (!string.IsNullOrEmpty(_statusNotification))
    {
        <div class="ascii-panel reveal-in library-notice">
            <pre class="status library-notice-text">@_statusNotification</pre>
        </div>
    }

    @if (_showDspRack)
    {
        <div class="soundboard-rack-panel ascii-border-double reveal-in vibe-glass-card">
            <div class="soundboard-header">
                <span class="soundboard-title">[ 🎛️ MEME DSP SOUNDBOARD RACK &amp; SPECTRUM ANALYZER ]</span>
                <div class="soundboard-controls">
                    <button class="ascii-btn compact-btn @(_bitcrusherOn ? "active" : "")" @onclick="ToggleBitcrusher">
                        @(_bitcrusherOn ? "[ 👾 8-BIT CRUNCH: ON ]" : "[ 16-BIT AUDIO ]")
                    </button>
                    <button class="ascii-btn compact-btn @(_bassBoostOn ? "active" : "")" @onclick="ToggleBassBoost">
                        @(_bassBoostOn ? "[ 💥 BASS BOOST: ON ]" : "[ NORMAL BASS ]")
                    </button>
                    <span class="soundboard-speed-label">SPEED: @(_playbackRate.ToString("F1"))x</span>
                    <input type="range" min="0.5" max="2.0" step="0.1" @bind="_playbackRate" @bind:after="OnRateChanged" class="soundboard-slider" />
                </div>
            </div>
            <canvas id="soundboard-spectrum-canvas" class="soundboard-spectrum-canvas"></canvas>
        </div>
    }

    @if (_showUploadModal)
    {
        <div class="upload-modal-panel ascii-border-double reveal-in vibe-glass-card">
            <div class="panel-header upload-panel-header">
                <span class="upload-panel-title">[ ⬆ UPLOAD CUSTOM MEME SOUND ]</span>
                <button class="ascii-btn compact-btn" @onclick="ToggleUploadModal">[ ✕ ]</button>
            </div>
            <div class="upload-form-row">
                <div class="upload-col">
                    <label class="input-label">AUDIO FILE (.mp3, .wav, .ogg, max 15MB)</label>
                    <InputFile OnChange="OnSoundFileSelected" accept=".mp3,.wav,.ogg,audio/*" class="ascii-input file-input-full" />
                </div>
                <div class="upload-col">
                    <label class="input-label">DISPLAY NAME</label>
                    <input class="ascii-input upload-field" placeholder="e.g. Vine Boom Ultra" @bind="_uploadName" />
                </div>
                <div class="upload-col">
                    <label class="input-label">ACTION TAGS (comma-separated)</label>
                    <input class="ascii-input upload-field" placeholder="e.g. punch, shock, bass" @bind="_uploadTags" />
                </div>
                <div class="upload-actions">
                    <button class="ascii-btn primary-action compact-btn" @onclick="UploadCustomSoundAsync" disabled="@(_uploadFile is null || _uploading)">
                        @(_uploading ? "[ ⏳ Uploading… ]" : "[ 💾 Save Sound ]")
                    </button>
                    <button class="ascii-btn compact-btn" @onclick="ToggleUploadModal">[ Cancel ]</button>
                </div>
            </div>
            @if (!string.IsNullOrEmpty(_uploadMessage))
            {
                <pre class="status upload-message">@_uploadMessage</pre>
            }
        </div>
    }

    @if (_loading)
    {
        <div class="loading-state ascii-border-double">
            <div class="retro-progress-bar"><div class="retro-progress-fill indeterminate"></div></div>
            <pre class="loading-text">[ Querying sound asset catalogue… ]</pre>
        </div>
    }
    else if (_sounds.Length == 0)
    {
        <div class="empty-state ascii-border-double reveal-in">
            <pre class="empty-text">[ No sound assets found ]</pre>
            <p class="empty-sub">No sounds match the current filter criteria.</p>
            <div class="empty-actions">
                <button class="ascii-btn" @onclick="ClearFilters">[ Clear Filters ]</button>
                <button class="ascii-btn is-cyan" @onclick="SeedDefaultSounds" disabled="@_seeding">
                    @(_seeding ? "[ ⏳ Seeding… ]" : "[ ⚡ Seed Default Meme Sounds ]")
                </button>
            </div>
        </div>
    }
    else
    {
        <div class="grid-container-viewport ascii-border-double vibe-glass-card">
            <RadzenDataGrid Data="@_sounds"
                            TItem="SoundAssetDto"
                            AllowSorting="true"
                            Class="rz-data-grid sounds-radzen-grid"
                            EmptyText="No sounds found">
                <Columns>
                    <RadzenDataGridColumn TItem="SoundAssetDto" Property="DisplayName" Title="Sound Name" Width="32%">
                        <Template Context="sound">
                            <span class="grid-sound-name">@sound.DisplayName</span>
                        </Template>
                    </RadzenDataGridColumn>

                    <RadzenDataGridColumn TItem="SoundAssetDto" Property="DurationMs" Title="Duration" Width="14%">
                        <Template Context="sound">
                            <span class="grid-sound-dur">@((sound.DurationMs / 1000.0).ToString("F2"))s</span>
                        </Template>
                    </RadzenDataGridColumn>

                    <RadzenDataGridColumn TItem="SoundAssetDto" Title="Tags" Width="38%">
                        <Template Context="sound">
                            <div class="sound-tag-row">
                                @foreach (var tag in sound.ActionVectorTags)
                                {
                                    <span class="ascii-tag cursor-pointer" @onclick="() => { TagFilter = tag; }">#@tag</span>
                                }
                            </div>
                        </Template>
                    </RadzenDataGridColumn>

                    <RadzenDataGridColumn TItem="SoundAssetDto" Title="Audition" Width="16%" TextAlign="TextAlign.Center">
                        <Template Context="sound">
                            <audio id="audio-@sound.SoundId" src="/api/memelibrary/sounds/@sound.SoundId/stream" preload="none"></audio>
                            <button class="ascii-btn compact-btn audition-btn @(_playingSoundId == sound.SoundId ? "active" : "")"
                                    @onclick="() => TogglePlaySound(sound.SoundId)">
                                @(_playingSoundId == sound.SoundId ? "[ ■ ]" : "[ ▶ ]")
                            </button>
                        </Template>
                    </RadzenDataGridColumn>
                </Columns>
            </RadzenDataGrid>
        </div>

        <div class="library-footer-row">
            <span class="count-badge">Showing @_sounds.Length of @_totalCount sound@(_totalCount == 1 ? "" : "s")</span>
            <div class="pagination-controls">
                <button class="ascii-btn compact-btn" @onclick="PrevPage" disabled="@(_page == 0 || _loading)">[ ◀ PREV ]</button>
                <span class="page-indicator">Page @(_page + 1) of @TotalPages</span>
                <button class="ascii-btn compact-btn" @onclick="NextPage" disabled="@(_page >= TotalPages - 1 || _loading)">[ NEXT ▶ ]</button>
            </div>
        </div>
    }

    @if (!string.IsNullOrEmpty(_errorMessage))
    {
        <div class="error-banner ascii-border-double">
            <pre class="error-text">[ ERROR ] @_errorMessage</pre>
        </div>
    }
</div>

@code {
    private SoundAssetDto[] _sounds = [];
    private int _totalCount;
    private int _page;
    private const int PageSize = 25;
    private bool _loading;
    private string? _errorMessage;
    private string? _statusNotification;

    private string _searchQuery = string.Empty;
    private string _tagFilter = string.Empty;

    // View toggles
    private bool _showDspRack;
    private Guid? _playingSoundId;

    // Upload Modal State
    private bool _showUploadModal;
    private IBrowserFile? _uploadFile;
    private string _uploadName = string.Empty;
    private string _uploadTags = string.Empty;
    private bool _uploading;
    private string? _uploadMessage;

    // DSP Soundboard Controls
    private bool _bitcrusherOn;
    private bool _bassBoostOn;
    private double _playbackRate = 1.0;

    private async Task ToggleBitcrusher()
    {
        _bitcrusherOn = !_bitcrusherOn;
        await JS.InvokeVoidAsync("soundboardFx.setBitcrusher", _bitcrusherOn);
    }

    private async Task ToggleBassBoost()
    {
        _bassBoostOn = !_bassBoostOn;
        await JS.InvokeVoidAsync("soundboardFx.setBassBoost", _bassBoostOn);
    }

    private async Task OnRateChanged()
    {
        await JS.InvokeVoidAsync("soundboardFx.setPlaybackRate", _playbackRate);
    }

    private async Task TogglePlaySound(Guid soundId)
    {
        if (_playingSoundId == soundId)
        {
            _playingSoundId = null;
            try
            {
                await JS.InvokeVoidAsync("soundboardFx.stopAll");
            }
            catch { }
        }
        else
        {
            _playingSoundId = soundId;
            try
            {
                await JS.InvokeVoidAsync("soundboardFx.playAudio", $"audio-{soundId}");
            }
            catch { }
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            try
            {
                await JS.InvokeVoidAsync("soundboardFx.init", "soundboard-spectrum-canvas");
            }
            catch { }
        }
    }

    private CancellationTokenSource? _debounceCts;

    private int TotalPages => Math.Max(1, (int)Math.Ceiling((double)_totalCount / PageSize));

    private string SearchQuery
    {
        get => _searchQuery;
        set
        {
            if (_searchQuery == value) return;
            _searchQuery = value;
            _page = 0;
            _ = DebouncedLoadAsync();
        }
    }

    private string TagFilter
    {
        get => _tagFilter;
        set
        {
            if (_tagFilter == value) return;
            _tagFilter = value;
            _page = 0;
            _ = DebouncedLoadAsync();
        }
    }

    protected override async Task OnInitializedAsync()
    {
        await LoadSounds();
    }

    private void ToggleUploadModal()
    {
        _showUploadModal = !_showUploadModal;
    }

    private void OnSoundFileSelected(InputFileChangeEventArgs e)
    {
        _uploadFile = e.File;
        if (string.IsNullOrWhiteSpace(_uploadName))
        {
            _uploadName = System.IO.Path.GetFileNameWithoutExtension(e.File.Name);
        }
    }

    private async Task UploadCustomSoundAsync()
    {
        if (_uploadFile is null) return;
        _uploading = true;
        _uploadMessage = null;
        StateHasChanged();

        try
        {
            using var content = new MultipartFormDataContent();
            using var stream = _uploadFile.OpenReadStream(maxAllowedSize: 15 * 1024 * 1024);
            var streamContent = new StreamContent(stream);
            streamContent.Headers.ContentType = new System.Net.Http.Headers.MediaTypeHeaderValue(_uploadFile.ContentType ?? "audio/mpeg");
            content.Add(streamContent, "file", _uploadFile.Name);
            if (!string.IsNullOrWhiteSpace(_uploadName))
                content.Add(new StringContent(_uploadName), "displayName");
            if (!string.IsNullOrWhiteSpace(_uploadTags))
                content.Add(new StringContent(_uploadTags), "tags");

            var resp = await Http.PostAsync("/api/memelibrary/upload", content);
            if (resp.IsSuccessStatusCode)
            {
                _statusNotification = $"[ UPLOAD COMPLETE: Sound '{_uploadName ?? _uploadFile.Name}' saved! ]";
                _showUploadModal = false;
                _uploadFile = null;
                _uploadName = string.Empty;
                _uploadTags = string.Empty;
                await LoadSounds();
            }
            else
            {
                _uploadMessage = $"Upload failed: HTTP {(int)resp.StatusCode}";
            }
        }
        catch (Exception ex)
        {
            _uploadMessage = $"Upload error: {ex.Message}";
        }
        finally
        {
            _uploading = false;
            StateHasChanged();
        }
    }

    private bool _seeding;

    private async Task SeedDefaultSounds()
    {
        _seeding = true;
        StateHasChanged();
        try
        {
            var resp = await Http.PostAsync("/api/memelibrary/seed", null);
            if (resp.IsSuccessStatusCode)
            {
                _statusNotification = "[ SEEDING COMPLETE: Default meme sound assets loaded into library. ]";
                await LoadSounds();
            }
            else
            {
                _errorMessage = $"Seed Failed: HTTP {(int)resp.StatusCode}";
            }
        }
        catch (Exception ex)
        {
            _errorMessage = $"Seed Failed: {ex.Message}";
        }
        finally
        {
            _seeding = false;
            StateHasChanged();
        }
    }

    private async Task DebouncedLoadAsync()
    {
        _debounceCts?.Cancel();
        _debounceCts?.Dispose();

        var cts = new CancellationTokenSource();
        _debounceCts = cts;

        try
        {
            await Task.Delay(350, cts.Token);
            await LoadSounds();
        }
        catch (TaskCanceledException)
        {
        }
    }

    private async Task PrevPage()
    {
        if (_page > 0) { _page--; await LoadSounds(); }
    }

    private async Task NextPage()
    {
        if (_page < TotalPages - 1) { _page++; await LoadSounds(); }
    }

    private async Task LoadSounds()
    {
        _loading = true;
        _errorMessage = null;
        StateHasChanged();

        try
        {
            var offset = _page * PageSize;
            var queryParams = new List<string> { $"offset={offset}", $"limit={PageSize}" };

            if (!string.IsNullOrWhiteSpace(_tagFilter))
                queryParams.Add($"tags={Uri.EscapeDataString(_tagFilter)}");

            if (!string.IsNullOrWhiteSpace(_searchQuery))
                queryParams.Add($"query={Uri.EscapeDataString(_searchQuery)}");

            var url = $"/api/memelibrary/sounds?{string.Join('&', queryParams)}";

            var response = await Http.GetFromJsonAsync<SoundsResponse>(url);
            _sounds = response?.Sounds ?? [];
            _totalCount = response?.TotalCount ?? 0;
        }
        catch (Exception ex)
        {
            _errorMessage = $"LOAD ERROR: {ex.Message}";
            _sounds = [];
            _totalCount = 0;
        }
        finally
        {
            _loading = false;
            StateHasChanged();
        }
    }

    private void ClearFilters()
    {
        _page = 0;
        _searchQuery = string.Empty;
        _tagFilter = string.Empty;
        _ = LoadSounds();
    }

    public void Dispose()
    {
        _debounceCts?.Cancel();
        _debounceCts?.Dispose();
    }

    private record SoundsResponse(int TotalCount, SoundAssetDto[] Sounds);
}