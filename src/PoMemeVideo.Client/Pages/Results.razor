@page "/results"
@inject HttpClient Http
@inject NavigationManager Nav
@using PoMemeVideo.Shared.Models
@using PoMemeVideo.Shared.Enums

<PageTitle>PoMemeVideo — History</PageTitle>

<div class="results-page">

    <div class="page-hero">
        <h1 class="hero-title">Video History</h1>
        <p class="hero-sub">Your completed meme videos — open to review, or download directly</p>
    </div>

    <div class="results-top-actions">
        <button class="ascii-btn compact-btn" @onclick='() => Nav.NavigateTo("/")'>[  + New Video ]</button>
    </div>

    @if (_loading)
    {
        <pre class="status">[ Loading… ]</pre>
    }
    else if (_error is not null)
    {
        <pre class="error-box">[ ERROR ] @_error</pre>
    }
    else if (_sessions.Count == 0)
    {
        <div class="empty-state ascii-border-double reveal-in">
            <pre class="status">[ No completed videos yet ]</pre>
            <p class="result-meta result-meta-empty">Your renders will appear here once processing completes.</p>
            <div class="empty-actions">
                <button class="ascii-btn" @onclick='() => Nav.NavigateTo("/")'>[ Create a Video ]</button>
            </div>
        </div>
    }
    else
    {
        <pre class="status">[ @_sessions.Count completed video@(_sessions.Count == 1 ? "" : "s") ]</pre>

        <div class="history-grid">
            @foreach (var session in _sessions)
            {
                <div class="history-card reveal-in">
                    <p class="history-card-title">Completed @(session.CompletedAt?.ToLocalTime().ToString("ddd, MMM d yyyy  HH:mm") ?? "—")</p>
                    <p class="history-card-id">SESSION: @session.SessionId.ToString()[..8]…</p>

                    <div class="history-card-meta">
                        <span class="history-meta-item">Duration: <span>@(session.VideoDurationSeconds.ToString("F1"))s</span></span>
                        <span class="history-meta-item">Aggressive: <span>@(session.AggressiveVisuals ? "Yes" : "No")</span></span>
                    </div>

                    @if (!string.IsNullOrEmpty(session.OutputBlobPath))
                    {
                        <div class="history-card-actions">
                            <button class="ascii-btn action-primary" @onclick='() => Nav.NavigateTo($"/reveal/{session.SessionId}")'> [ Open &amp; Review ]</button>
                            <button class="ascii-btn action-secondary" @onclick="() => DownloadVideo(session.SessionId)">[ ⬇ Download ]</button>
                        </div>

                            <div class="history-card-preview">
                                <video preload="none" loop playsinline
                                       onmouseenter="this.play()" onmouseleave="this.pause(); this.currentTime=0;">
                                    <source src="/api/output/sessions/@session.SessionId/stream/video" type="video/mp4" />
                                </video>
                            </div>

                        <div class="history-card-danger">
                            @if (_pendingDeleteSessionId == session.SessionId)
                            {
                                <pre class="clear-warning">⚠ This will permanently delete the video and script.</pre>
                                <button class="ascii-btn wipe-btn compact-btn" @onclick="() => DeleteSession(session)">[ Confirm Delete ]</button>
                                <button class="ascii-btn compact-btn" @onclick="CancelDelete">[ Cancel ]</button>
                            }
                            else
                            {
                                <button class="ascii-btn wipe-btn compact-btn" @onclick="() => RequestDelete(session.SessionId)">[ Delete ]</button>
                            }
                        </div>
                    }
                    else
                    {
                        <pre class="page-error">  OUTPUT NOT AVAILABLE</pre>
                    }
                </div>
            }
        </div>
    }
</div>

@code {
    private List<VideoSessionDto> _sessions = [];
    private bool _loading = true;
    private string? _error;
    private Guid? _expandedSessionId;
    private Guid? _loadingScriptSessionId;
    private Guid? _pendingDeleteSessionId;
    private readonly Dictionary<Guid, DirectorScriptDto?> _scriptCache = [];

    protected override async Task OnInitializedAsync()
    {
        await LoadResults();
    }

    private async Task LoadResults()
    {
        _loading = true;
        _error = null;
        try
        {
            var results = await Http.GetFromJsonAsync<List<VideoSessionDto>>("/api/output/results");
            _sessions = results ?? [];
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _loading = false;
        }
    }

    private void DownloadVideo(Guid sessionId)
    {
        Nav.NavigateTo($"/api/output/sessions/{sessionId}/download/video", forceLoad: true);
    }

    private async Task ToggleQuickReveal(VideoSessionDto session)
    {
        if (_expandedSessionId == session.SessionId)
        {
            _expandedSessionId = null;
            return;
        }

        _expandedSessionId = session.SessionId;
        _pendingDeleteSessionId = null;

        if (_scriptCache.ContainsKey(session.SessionId))
            return;

        _loadingScriptSessionId = session.SessionId;
        try
        {
            _scriptCache[session.SessionId] = await Http.GetFromJsonAsync<DirectorScriptDto>($"/api/output/sessions/{session.SessionId}/script");
        }
        catch
        {
            _scriptCache[session.SessionId] = null;
        }
        finally
        {
            _loadingScriptSessionId = null;
        }
    }

    private void RequestDelete(Guid sessionId)
    {
        _pendingDeleteSessionId = sessionId;
    }

    private void CancelDelete()
    {
        _pendingDeleteSessionId = null;
    }

    private async Task DeleteSession(VideoSessionDto session)
    {
        _pendingDeleteSessionId = null;
        var response = await Http.DeleteAsync($"/api/output/sessions/{session.SessionId}");
        if (response.IsSuccessStatusCode)
        {
            _sessions.Remove(session);
            _scriptCache.Remove(session.SessionId);
            if (_expandedSessionId == session.SessionId)
                _expandedSessionId = null;
        }
    }
}
