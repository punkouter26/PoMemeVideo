@page "/results"
@inject HttpClient Http
@inject NavigationManager Nav
@inject IJSRuntime JS
@inject Radzen.DialogService DialogService
@using PoMemeVideo.Shared.Models
@using PoMemeVideo.Shared.Enums

<PageTitle>PoMemeVideo — History Gallery</PageTitle>

<div class="results-viewport">
    <div class="results-header-row">
        <div class="results-title-group">
            <h1 class="hero-title">Video History Gallery</h1>
            <span class="hero-sub">Your completed meme creations — inspect, batch download, or manage</span>
        </div>

        <div class="results-toolbar">
            <button class="ascii-btn compact-btn primary-action" @onclick='() => Nav.NavigateTo("/")'>[ + Create Video ]</button>
            <input class="ascii-input results-search" placeholder="Search session ID…" @bind="_searchFilter" @bind:event="oninput" />
            <button class="ascii-btn compact-btn" @onclick="LoadSessions" disabled="@_loading">[ ⟳ Refresh ]</button>
            @if (_selectedSessionIds.Count > 0)
            {
                <button class="ascii-btn compact-btn wipe-btn" @onclick="ConfirmBatchDelete">
                    [ 🗑️ Delete (@_selectedSessionIds.Count) ]
                </button>
                <button class="ascii-btn compact-btn" @onclick="ClearSelection">[ Deselect ]</button>
            }
        </div>
    </div>

    @if (!string.IsNullOrEmpty(_statusNotification))
    {
        <div class="ascii-panel reveal-in results-notice">
            <pre class="status results-notice-text">@_statusNotification</pre>
        </div>
    }

    @if (_loading)
    {
        <div class="loading-wrap ascii-border-double">
            <div class="retro-progress-bar"><div class="retro-progress-fill indeterminate"></div></div>
            <pre class="status">[ Loading video session history… ]</pre>
        </div>
    }
    else if (_error is not null)
    {
        <div class="error-box ascii-border-double">
            <pre class="error-text">[ ERROR ] @_error</pre>
        </div>
    }
    else if (FilteredSessions.Count == 0)
    {
        <div class="empty-state ascii-border-double reveal-in">
            <pre class="status">[ No completed videos found ]</pre>
            <p class="result-meta-empty">Your AI-rendered meme videos will appear here once ready.</p>
            <div class="empty-actions">
                <button class="ascii-btn" @onclick='() => Nav.NavigateTo("/")'>[ Create a Video ]</button>
            </div>
        </div>
    }
    else
    {
        <div class="results-workspace-grid">
            <!-- Left: Sessions Master Grid -->
            <div class="results-pane results-pane-list ascii-border-double vibe-glass-card">
                <div class="pane-header">
                    <span>COMPLETED SESSIONS (@FilteredSessions.Count)</span>
                </div>

                <div class="sessions-scroll-list">
                    @foreach (var session in FilteredSessions)
                    {
                        var isSelected = _selectedSessionIds.Contains(session.SessionId);
                        var isActive = _activeSession?.SessionId == session.SessionId;

                        <div class="session-list-item @(isActive ? "is-active-session" : "") @(isSelected ? "is-selected-checkbox" : "")"
                             @onclick="() => SelectActiveSession(session)">
                            <div class="session-item-row">
                                <input type="checkbox"
                                       checked="@isSelected"
                                       @onclick:stopPropagation="true"
                                       @onchange="@(e => ToggleSelection(session.SessionId, (bool)(e.Value ?? false)))"
                                       class="results-select-box" />

                                <div class="session-item-info">
                                    <div class="session-item-id">
                                        ID: @session.SessionId.ToString()[..8]…
                                    </div>
                                    <div class="session-item-date">
                                        @(session.CompletedAt?.ToLocalTime().ToString("MMM d, yyyy HH:mm") ?? "—")
                                    </div>
                                </div>

                                <div class="session-item-badges">
                                    <span class="rz-badge rz-badge-info">@(session.VideoDurationSeconds.ToString("F1"))s</span>
                                    @if (!string.IsNullOrEmpty(session.MemePersona))
                                    {
                                        <span class="rz-badge rz-badge-warning">@session.MemePersona</span>
                                    }
                                </div>
                            </div>
                        </div>
                    }
                </div>
            </div>

            <!-- Right: Active Session Preview & Actions -->
            <div class="results-pane results-pane-preview ascii-border-double vibe-glass-card">
                @if (_activeSession is not null)
                {
                    <div class="pane-header preview-header">
                        <span>PREVIEW &amp; ACTIONS · ID: @_activeSession.SessionId.ToString()[..8]…</span>
                        <button class="ascii-btn compact-btn wipe-btn" @onclick="() => ConfirmDeleteSession(_activeSession)">[ 🗑️ Delete ]</button>
                    </div>

                    @if (!string.IsNullOrEmpty(_activeSession.OutputBlobPath))
                    {
                        <div class="results-video-stage">
                            <video class="results-preview-video" controls playsinline loop
                                   key="@_activeSession.SessionId">
                                <source src="/api/output/sessions/@_activeSession.SessionId/stream/video" type="video/mp4" />
                            </video>
                        </div>

                        <div class="results-meta-chips">
                            <span class="meta-chip">Duration: <b>@(_activeSession.VideoDurationSeconds.ToString("F1"))s</b></span>
                            <span class="meta-chip">Persona: <b>@(_activeSession.MemePersona ?? "Standard")</b></span>
                            <span class="meta-chip">Ratio: <b>@(_activeSession.AspectRatio ?? "16:9")</b></span>
                            <span class="meta-chip">Aggressive: <b>@(_activeSession.AggressiveVisuals ? "YES" : "NO")</b></span>
                        </div>

                        <div class="results-actions-grid">
                            <button class="ascii-btn primary-action compact-btn" @onclick='() => Nav.NavigateTo($"/reveal/{_activeSession.SessionId}")'>
                                [ 👁️ Review &amp; Studio ]
                            </button>
                            <button class="ascii-btn compact-btn" @onclick="() => DownloadVideo(_activeSession.SessionId)">
                                [ ⬇ MP4 ]
                            </button>
                            <button class="ascii-btn compact-btn" @onclick="() => ExportGif(_activeSession.SessionId)">
                                [ 🎞 GIF ]
                            </button>
                            <button class="ascii-btn compact-btn" @onclick="() => ExportPunchline(_activeSession.SessionId)">
                                [ 🎯 5s Clip ]
                            </button>
                        </div>
                    }
                    else
                    {
                        <div class="output-pending-box">
                            <pre>[ OUTPUT NOT READY OR PROCESSING ]</pre>
                        </div>
                    }
                }
                else
                {
                    <div class="select-prompt-box">
                        <span class="term-muted">Select a session from the list to preview video.</span>
                    </div>
                }
            </div>
        </div>
    }
</div>

@code {
    private List<VideoSessionDto> _sessions = [];
    private HashSet<Guid> _selectedSessionIds = [];
    private VideoSessionDto? _activeSession;
    private bool _loading = true;
    private string? _error;
    private string? _statusNotification;
    private string _searchFilter = string.Empty;

    private List<VideoSessionDto> FilteredSessions => _sessions
        .Where(s => string.IsNullOrWhiteSpace(_searchFilter) ||
                    s.SessionId.ToString().Contains(_searchFilter, StringComparison.OrdinalIgnoreCase))
        .ToList();

    protected override async Task OnInitializedAsync()
    {
        await LoadSessions();
    }

    private void SelectActiveSession(VideoSessionDto session)
    {
        _activeSession = session;
    }

    private void ToggleSelection(Guid sessionId, bool selected)
    {
        if (selected) _selectedSessionIds.Add(sessionId);
        else _selectedSessionIds.Remove(sessionId);
    }

    private void ClearSelection() => _selectedSessionIds.Clear();

    private void Notify(string message)
    {
        _statusNotification = message;
    }

    private async Task LoadSessions()
    {
        _loading = true;
        _error = null;
        _selectedSessionIds.Clear();
        StateHasChanged();

        try
        {
            var response = await Http.GetAsync("/api/ingestion/sessions?status=Complete");
            if (!response.IsSuccessStatusCode)
            {
                _error = $"HTTP {(int)response.StatusCode}";
                _sessions = [];
                _activeSession = null;
                return;
            }

            var list = await response.Content.ReadFromJsonAsync<List<VideoSessionDto>>();
            _sessions = list?.OrderByDescending(s => s.CompletedAt ?? s.CreatedAt).ToList() ?? [];
            if (_activeSession is null || !_sessions.Any(s => s.SessionId == _activeSession.SessionId))
            {
                _activeSession = _sessions.FirstOrDefault();
            }
        }
        catch (Exception ex)
        {
            _error = ex.Message;
            _sessions = [];
            _activeSession = null;
        }
        finally
        {
            _loading = false;
            StateHasChanged();
        }
    }

    private async Task DownloadVideo(Guid sessionId)
    {
        try
        {
            var downloadUrl = $"/api/output/sessions/{sessionId}/download/video";
            var fileName = $"pomemevideo_{sessionId:N}.mp4";
            await JS.InvokeVoidAsync("poBrowser.downloadUrl", downloadUrl, fileName);
            Notify($"[ DOWNLOAD STARTED: {fileName} ]");
        }
        catch (Exception ex)
        {
            Notify($"[ DOWNLOAD ERROR: {ex.Message} ]");
        }
    }

    private async Task ExportGif(Guid sessionId)
    {
        try
        {
            var downloadUrl = $"/api/output/sessions/{sessionId}/export/gif";
            var fileName = $"pomeme_{sessionId:N}.gif";
            await JS.InvokeVoidAsync("poBrowser.downloadUrl", downloadUrl, fileName);
            Notify($"[ GIF EXPORTED: {fileName} ]");
        }
        catch (Exception ex)
        {
            Notify($"[ GIF EXPORT ERROR: {ex.Message} ]");
        }
    }

    private async Task ExportPunchline(Guid sessionId)
    {
        try
        {
            var downloadUrl = $"/api/output/sessions/{sessionId}/export/punchline";
            var fileName = $"punchline_{sessionId:N}.mp4";
            await JS.InvokeVoidAsync("poBrowser.downloadUrl", downloadUrl, fileName);
            Notify($"[ PUNCHLINE CLIP EXPORTED: {fileName} ]");
        }
        catch (Exception ex)
        {
            Notify($"[ PUNCHLINE CLIP ERROR: {ex.Message} ]");
        }
    }

    private async Task ConfirmDeleteSession(VideoSessionDto session)
    {
        var confirmed = await DialogService.Confirm(
            $"Permanently delete session {session.SessionId.ToString()[..8]}…?",
            "Confirm Deletion",
            new Radzen.ConfirmOptions { OkButtonText = "Delete", CancelButtonText = "Cancel" });

        if (confirmed == true)
        {
            await DeleteSession(session);
        }
    }

    private async Task ConfirmBatchDelete()
    {
        var count = _selectedSessionIds.Count;
        var confirmed = await DialogService.Confirm(
            $"Permanently delete {count} selected session(s)?",
            "Confirm Batch Deletion",
            new Radzen.ConfirmOptions { OkButtonText = "Delete Selected", CancelButtonText = "Cancel" });

        if (confirmed == true)
        {
            await DeleteSelectedSessions();
        }
    }

    private async Task DeleteSession(VideoSessionDto session)
    {
        try
        {
            var resp = await Http.DeleteAsync($"/api/output/sessions/{session.SessionId}");
            if (resp.IsSuccessStatusCode)
            {
                _sessions.Remove(session);
                _selectedSessionIds.Remove(session.SessionId);
                if (_activeSession?.SessionId == session.SessionId)
                {
                    _activeSession = _sessions.FirstOrDefault();
                }
                Notify($"[ DELETED: Session {session.SessionId.ToString()[..8]}… deleted. ]");
            }
            else
            {
                Notify($"[ DELETE FAILED: HTTP {(int)resp.StatusCode} ]");
            }
        }
        catch (Exception ex)
        {
            Notify($"[ DELETE FAILED: {ex.Message} ]");
        }
    }

    private async Task DeleteSelectedSessions()
    {
        var count = _selectedSessionIds.Count;
        var failed = 0;
        foreach (var id in _selectedSessionIds.ToList())
        {
            try
            {
                var resp = await Http.DeleteAsync($"/api/output/sessions/{id}");
                if (resp.IsSuccessStatusCode)
                {
                    _sessions.RemoveAll(s => s.SessionId == id);
                }
                else
                {
                    failed++;
                }
            }
            catch
            {
                failed++;
            }
        }
        _selectedSessionIds.Clear();
        _activeSession = _sessions.FirstOrDefault();
        if (failed > 0)
        {
            Notify($"[ BATCH DELETE: Deleted {count - failed} of {count} sessions ({failed} failed). ]");
        }
        else
        {
            Notify($"[ BATCH DELETE COMPLETE: Deleted {count} sessions. ]");
        }
        StateHasChanged();
    }
}