@page "/engine/{SessionId:guid}"
@inject NavigationManager Nav
@inject HttpClient Http
@inject IConfiguration Configuration
@inject IJSRuntime JS
@implements IAsyncDisposable

<PageTitle>PoMemeVideo — Processing</PageTitle>

<div class="engine-viewport">
    <div class="engine-top-cluster">
        <div class="engine-hero">
            <h1 class="engine-hero-title">Processing Your Video</h1>
            <span class="engine-hero-session">Session: @SessionId</span>
        </div>

        <div class="engine-progress-strip">
            <div class="engine-progress-step step-done"><span class="step-dot"></span> Connected</div>
            <span class="engine-step-sep">›</span>
            <div class="engine-progress-step step-done"><span class="step-dot"></span> Ingested</div>
            <span class="engine-step-sep">›</span>
            <div class="engine-progress-step step-active"><span class="step-dot"></span> AI Directing…</div>
            <span class="engine-step-sep">›</span>
            <div class="engine-progress-step"><span class="step-dot"></span> Rendering</div>
            <span class="engine-step-sep">›</span>
            <div class="engine-progress-step"><span class="step-dot"></span> Complete</div>
        </div>
    </div>

    @if (_hubClient is not null)
    {
        <!-- Mobile Segmented Tab Switcher (visible <= 820px) -->
        <div class="engine-tab-switch-bar">
            <button class="ascii-btn compact-btn @(_selectedTabIndex == 0 ? "primary-action is-active" : "")"
                    @onclick="() => _selectedTabIndex = 0">
                [ 🎬 Director's Script ]
            </button>
            <button class="ascii-btn compact-btn @(_selectedTabIndex == 1 ? "primary-action is-active" : "")"
                    @onclick="() => _selectedTabIndex = 1">
                [ 📜 Processing Log ]
            </button>
        </div>

        <!-- Unified Dual Console (Single instantiation of each feed component) -->
        <div class="engine-consoles-container">
            <div class="console-panel script-console ascii-border-double vibe-glass-card @(_selectedTabIndex == 0 ? "is-visible-mobile" : "is-hidden-mobile")">
                <DirectorScriptFeed HubClient="_hubClient" />
            </div>

            <div class="console-panel log-console ascii-border-double vibe-glass-card @(_selectedTabIndex == 1 ? "is-visible-mobile" : "is-hidden-mobile")">
                <DirectorLogFeed HubClient="_hubClient" />
            </div>
        </div>
    }

    @if (!string.IsNullOrEmpty(_errorMessage))
    {
        <div class="error-box ascii-border-double reveal-in engine-error-box">
            <pre class="engine-error-text">[ PROCESSING ERROR ] @_errorMessage</pre>
            <div class="engine-error-actions">
                <button class="ascii-btn primary-action compact-btn" @onclick="RetryWithFallbackAsync" disabled="@_retrying">
                    @(_retrying ? "[ ⏳ Retrying… ]" : "[ ↺ Retry with Safe Fallback Mode ]")
                </button>
                <button class="ascii-btn compact-btn" @onclick='() => Nav.NavigateTo("/")'>
                    [ ⬅ Back to Source ]
                </button>
            </div>
        </div>
    }
</div>

@code {
    [Parameter] public Guid SessionId { get; set; }

    private EngineHubClient? _hubClient;
    private string? _errorMessage;
    private int _selectedTabIndex = 0;
    private bool _retrying;

    private async Task RetryWithFallbackAsync()
    {
        _retrying = true;
        _errorMessage = null;
        StateHasChanged();

        try
        {
            var response = await Http.PostAsync($"/api/processing/sessions/{SessionId}/initiate?forceFallback=true", null);
            if (!response.IsSuccessStatusCode && response.StatusCode != System.Net.HttpStatusCode.Conflict)
            {
                var body = await response.Content.ReadAsStringAsync();
                _errorMessage = $"Retry failed: {body}";
            }
        }
        catch (Exception ex)
        {
            _errorMessage = $"Retry error: {ex.Message}";
        }
        finally
        {
            _retrying = false;
            StateHasChanged();
        }
    }

    protected override async Task OnInitializedAsync()
    {
        var apiBase = Configuration["ApiBaseUrl"] ?? Nav.BaseUri.TrimEnd('/');
        var hubUrl = apiBase.TrimEnd('/') + "/hubs/engine";
        _hubClient = new EngineHubClient(hubUrl);

        _hubClient.ProcessingComplete += OnComplete;
        _hubClient.ProcessingError += OnError;

        await _hubClient.JoinSessionAsync(SessionId);

        _ = Task.Run(async () =>
        {
            try
            {
                var response = await Http.PostAsync(
                    $"/api/processing/sessions/{SessionId}/initiate",
                    null);

                if (response.IsSuccessStatusCode)
                    return; // 202 Accepted

                if (response.StatusCode == System.Net.HttpStatusCode.Conflict)
                {
                    var scriptResponse = await Http.GetAsync(
                        $"/api/output/sessions/{SessionId}/script");
                    if (scriptResponse.IsSuccessStatusCode)
                    {
                        await InvokeAsync(() => Nav.NavigateTo($"/reveal/{SessionId}"));
                        return;
                    }
                    return;
                }

                var body = await response.Content.ReadAsStringAsync();
                _errorMessage = $"HTTP {(int)response.StatusCode}: {body}";
                await InvokeAsync(StateHasChanged);
            }
            catch (Exception ex)
            {
                _errorMessage = ex.Message;
                await InvokeAsync(StateHasChanged);
            }
        });
    }

    private void OnComplete(string outputBlobPath)
    {
        InvokeAsync(() => Nav.NavigateTo($"/reveal/{SessionId}"));
    }

    private void OnError(string message)
    {
        _errorMessage = message;
        InvokeAsync(StateHasChanged);
    }

    public async ValueTask DisposeAsync()
    {
        if (_hubClient is not null)
        {
            _hubClient.ProcessingComplete -= OnComplete;
            _hubClient.ProcessingError -= OnError;
            await _hubClient.LeaveSessionAsync(SessionId);
            await _hubClient.DisposeAsync();
        }
    }
}
