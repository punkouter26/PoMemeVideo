@page "/"
@page "/source"
@inject HttpClient Http
@inject NavigationManager Nav
@inject IJSRuntime JS
@inject BlobUploadService BlobUpload
@inject NavRefreshService NavRefresh
@using Microsoft.AspNetCore.Components.Forms
@using PoMemeVideo.Client.Services
@using PoMemeVideo.Client.Components
@using PoMemeVideo.Shared.Enums

<PageTitle>PoMemeVideo — Create</PageTitle>

<div class="source-page">

    <div class="page-hero">
        <h1 class="hero-title">Create a Meme Video</h1>
        <p class="hero-sub">Upload a video · Choose AI mode · We do the rest</p>
    </div>

    <div class="step-track" aria-label="Source flow">
        <div class="step-pill @GetStepClass(1)"><span class="step-num">1</span>&nbsp;Upload</div>
        <div class="step-connector"></div>
        <div class="step-pill @GetStepClass(2)"><span class="step-num">2</span>&nbsp;Analyze</div>
        <div class="step-connector"></div>
        <div class="step-pill @GetStepClass(3)"><span class="step-num">3</span>&nbsp;Render</div>
    </div>

    <div class="ai-mode-card ascii-border-double reveal-in vibe-glass-card vibe-3d-stage">
        <div class="ai-mode-header">
            <span class="ai-mode-label">AI Model</span>
            <span class="ai-mode-active">ACTIVE: @_displayActiveModel</span>
        </div>

        <div class="ai-model-row">
            <select class="ai-model-dropdown-select" @bind="_pendingModelSelection" @bind:after="OnModelSelectionChanged" aria-label="AI model selector">
                @if (_foundryDeployments.Count > 0)
                {
                    <optgroup label="☁ Remote · AI Foundry">
                        @foreach (var dep in _foundryDeployments)
                        {
                            <option value="@($"remote:{dep}")">@dep</option>
                        }
                    </optgroup>
                }
                @if (_isDevelopment && _ollamaModels.Count > 0)
                {
                    <optgroup label="🦙 Local · Ollama">
                        @foreach (var m in _ollamaModels)
                        {
                            <option value="@($"ollama:{m}")">@m</option>
                        }
                    </optgroup>
                }
                @if (_localModels.Count > 0)
                {
                    <optgroup label="⚡ Browser · WebGPU">
                        @foreach (var model in _localModels)
                        {
                            <option value="@($"browser:{model.Id}")" disabled="@(!model.Available)">
                                @model.Label@(!model.Available ? " (not downloaded)" : "")
                            </option>
                        }
                    </optgroup>
                }
            </select>
            @if (_modelDirty)
            {
                <button class="ascii-btn apply-model-btn" @onclick="ApplyModelAsync" disabled="@_modelApplying">
                    @(_modelApplying ? "[ Applying… ]" : "[ Apply ]")
                </button>
            }
        </div>

        <span class="ai-model-dropdown-hint">@_dropdownHint</span>
        @if (!string.IsNullOrWhiteSpace(_modelMessage))
        {
            <pre class="clear-status">@_modelMessage</pre>
        }
    </div>

    <div class="dropzone-host @(_uploaded ? "is-uploaded" : null) vibe-glass-card vibe-3d-stage">
        <AsciiDropZone OnFileAccepted="OnFileAccepted" />
    </div>

    @* Hidden video element used for keyframe extraction — not visible to the user *@
    <video @ref="_videoRef"
           class="keyframe-source"
           preload="metadata"
           muted
           playsinline>
    </video>

    @if (_selectedFile is not null && !_uploaded)
    {
        <div class="upload-status ascii-border-double vibe-glass-card">
            <pre>
 FILE    : @_selectedFile.Name
 SIZE    : @(_selectedFile.Size / 1024 / 1024) MB
 STATUS  : @_statusMessage</pre>

            <div class="retro-progress-bar" style="margin: 0.5rem 0;"><div class="retro-progress-fill" style="width: @(_uploadProgress)%"></div></div>
        </div>
    }

    @if (_keyframeStripVisible)
    {
        <DitheredKeyframeStrip @ref="_keyframeStrip" VideoElement="_videoRef" />

        @if (_visionLabels.Count > 0)
        {
            <div class="vision-labels ascii-border-double">
                <pre class="vision-header">╔══════════════════════════════════════╗
║  AI VISION — SCENE ANALYSIS         ║
╚══════════════════════════════════════╝</pre>
                @foreach (var label in _visionLabels)
                {
                    <pre class="vision-entry"> t=@(label.TimestampSeconds.ToString("F1"))s │ @label.Label.ToUpperInvariant()</pre>
                }
            </div>
        }
        else if (_visionAnalysed)
        {
            <pre class="vision-fallback"> @_visionFallbackMessage</pre>
        }

        <div class="session-tuning-card ascii-border-double vibe-glass-card" style="margin: 1rem 0; padding: 1rem;">
            <div class="tuning-header" style="font-weight: bold; margin-bottom: 0.75rem; color: var(--rt-accent-cyan, #00ffdc);">
                🎬 DIRECTING CONFIG & FRAMING
            </div>

            <div class="tuning-grid" style="display: grid; grid-template-columns: repeat(auto-fit, minmax(260px, 1fr)); gap: 1rem;">
                <!-- Aspect Ratio -->
                <div class="tuning-group">
                    <label class="tuning-label" style="display: block; font-size: 0.85rem; margin-bottom: 0.25rem;">ASPECT RATIO</label>
                    <div class="aspect-ratio-buttons" style="display: flex; gap: 0.5rem; flex-wrap: wrap;">
                        <button type="button" class="ascii-btn @(_aspectRatio == "original" ? "is-active" : "")"
                                style="flex: 1; padding: 0.35rem; font-size: 0.8rem; @(_aspectRatio == "original" ? "border-color: #00ffdc; color: #00ffdc;" : "")"
                                @onclick='() => SetAspectRatio("original")'>
                            16:9 Landscape
                        </button>
                        <button type="button" class="ascii-btn @(_aspectRatio == "9:16" ? "is-active" : "")"
                                style="flex: 1; padding: 0.35rem; font-size: 0.8rem; @(_aspectRatio == "9:16" ? "border-color: #00ffdc; color: #00ffdc;" : "")"
                                @onclick='() => SetAspectRatio("9:16")'>
                            9:16 Vertical
                        </button>
                        <button type="button" class="ascii-btn @(_aspectRatio == "1:1" ? "is-active" : "")"
                                style="flex: 1; padding: 0.35rem; font-size: 0.8rem; @(_aspectRatio == "1:1" ? "border-color: #00ffdc; color: #00ffdc;" : "")"
                                @onclick='() => SetAspectRatio("1:1")'>
                            1:1 Square
                        </button>
                    </div>
                </div>

                <!-- Meme Persona -->
                <div class="tuning-group">
                    <label class="tuning-label" style="display: block; font-size: 0.85rem; margin-bottom: 0.25rem;">DIRECTOR PERSONA</label>
                    <select class="ai-model-dropdown-select" style="width: 100%;" @bind="_memePersona" @bind:after="OnPersonaChanged">
                        <option value="Standard">Standard Modern Meme</option>
                        <option value="Brainrot">Gen-Z Brainrot (Chaos / Vine Boom)</option>
                        <option value="MLG">2016 MLG Parody (Airhorn / Hitmarkers)</option>
                        <option value="Sitcom">90s TV Sitcom (Punchline & Laughs)</option>
                        <option value="Drama">Cinematic Drama Thriller</option>
                        <option value="Anime">Anime Melodrama</option>
                    </select>
                </div>

                <!-- Video Trimmer -->
                @if (_videoDurationSeconds > 3)
                {
                    <div class="tuning-group" style="grid-column: 1 / -1;">
                        <label class="tuning-label" style="display: block; font-size: 0.85rem; margin-bottom: 0.25rem;">
                            TRIM TIMELINE: @(_trimStart.ToString("F1"))s - @(_trimEnd.ToString("F1"))s (@((_trimEnd - _trimStart).ToString("F1"))s selected)
                        </label>
                        <div style="display: flex; gap: 1rem; align-items: center;">
                            <span style="font-size: 0.8rem;">Start:</span>
                            <input type="range" min="0" max="@(_videoDurationSeconds - 1)" step="0.5"
                                   @bind="_trimStart" @bind:after="OnTrimChanged" style="flex: 1;" />
                            <span style="font-size: 0.8rem;">End:</span>
                            <input type="range" min="@(_trimStart + 1)" max="@_videoDurationSeconds" step="0.5"
                                   @bind="_trimEnd" @bind:after="OnTrimChanged" style="flex: 1;" />
                        </div>
                    </div>
                }
            </div>
        </div>

        <div class="controls">
            <label class="ascii-toggle">
                <input type="checkbox" @bind="_aggressiveVisuals" />
                [ AGGRESSIVE VISUALS : @(_aggressiveVisuals ? "ON " : "OFF") ]
            </label>

            <button class="ascii-btn primary-action"
                    @onclick="OnInitiate"
                    disabled="@(_initiating || _visionInProgress)">
                @if (_visionInProgress)
                {
                    <span>[ Analysing… please wait ]</span>
                }
                else
                {
                    <span>@(_initiating ? "[ Starting… ]" : "[ Create Meme Video ]")</span>
                }
            </button>

            <button class="ascii-btn compact-btn" @onclick='() => Nav.NavigateTo("/results")'>[ View History ]</button>
        </div>
    }

    @if (_soundLibraryEmpty)
    {
        <pre class="page-error">⚠ SOUND LIBRARY IS EMPTY — run: dotnet run -- seed-sounds  (or: python SCRIPTS/seed-meme-sounds.py)
  Videos will be created without meme sounds until the library is seeded.</pre>
    }

    @if (!string.IsNullOrEmpty(_errorMessage))
    {
        <pre class="page-error">⚠ @_errorMessage</pre>
    }

</div>
