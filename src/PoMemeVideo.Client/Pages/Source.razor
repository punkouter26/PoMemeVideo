@page "/"
@page "/source"
@inject HttpClient Http
@inject NavigationManager Nav
@inject IJSRuntime JS
@inject BlobUploadService BlobUpload
@inject NavRefreshService NavRefresh
@inject CyberAudioService Audio
@using Microsoft.AspNetCore.Components.Forms
@using PoMemeVideo.Client.Services
@using PoMemeVideo.Client.Components
@using PoMemeVideo.Shared.Enums

<PageTitle>PoMemeVideo — Create</PageTitle>

<div class="source-viewport">
    <div class="source-topbar">
        <div class="source-title-group">
            <h1 class="hero-title">Create a Meme Video</h1>
            <span class="hero-sub">Upload a video · Choose AI mode · We do the rest</span>
        </div>

        <div class="step-track" aria-label="Source flow">
            <div class="step-pill @GetStepClass(1)"><span class="step-num">1</span>&nbsp;Upload</div>
            <div class="step-connector"></div>
            <div class="step-pill @GetStepClass(2)"><span class="step-num">2</span>&nbsp;Analyze</div>
            <div class="step-connector"></div>
            <div class="step-pill @GetStepClass(3)"><span class="step-num">3</span>&nbsp;Render</div>
        </div>
    </div>

    <div class="source-workspace-grid">
        <!-- Column 1: Video Ingestion / Visual Inspection -->
        <div class="source-pane source-pane-media">
            @if (!_uploaded)
            {
                <div class="dropzone-host ascii-border-double vibe-glass-card">
                    <AsciiDropZone OnFileAccepted="OnFileAccepted" />
                </div>

                @if (_selectedFile is not null)
                {
                    <div class="upload-status ascii-border-double vibe-glass-card">
                        <pre class="upload-status-meta">
 FILE    : @_selectedFile.Name
 SIZE    : @(_selectedFile.Size / 1024 / 1024) MB
 STATUS  : @_statusMessage</pre>
                        <div class="retro-progress-bar upload-progress-bar">
                            <div class="retro-progress-fill" style="--upload-progress: @(_uploadProgress)%"></div>
                        </div>
                    </div>
                }
            }
            else
            {
                <div class="visual-analysis-card ascii-border-double vibe-glass-card">
                    <div class="visual-card-header">[ 👁️ SCENE &amp; KEYFRAME TELEMETRY ]</div>
                    @if (_keyframeStripVisible)
                    {
                        <DitheredKeyframeStrip @ref="_keyframeStrip" VideoElement="_videoRef" />

                        @if (_visionLabels.Count > 0)
                        {
                            <div class="vision-labels-scroll">
                                @foreach (var label in _visionLabels)
                                {
                                    <div class="vision-entry-chip">
                                        <span class="vision-time">t=@(label.TimestampSeconds.ToString("F1"))s</span>
                                        <span class="vision-tag">@label.Label.ToUpperInvariant()</span>
                                    </div>
                                }
                            </div>
                        }
                        else if (_visionAnalysed)
                        {
                            <pre class="vision-fallback">@_visionFallbackMessage</pre>
                        }
                    }
                </div>
            }

            @* Offscreen decoder surface for keyframe extraction *@
            <video @ref="_videoRef" class="keyframe-source" preload="metadata" muted playsinline></video>
        </div>

        <!-- Column 2: AI Config & Directing Controls -->
        <div class="source-pane source-pane-config">
            <div class="ai-mode-card ascii-border-double vibe-glass-card">
                <div class="ai-mode-header">
                    <span class="ai-mode-label">AI DIRECTOR MODEL</span>
                    <span class="ai-mode-active">ACTIVE: @_displayActiveModel</span>
                </div>

                <div class="ai-model-row">
                    <select class="ai-model-dropdown-select" @bind="_pendingDeployment" @bind:after="OnModelSelectionChanged" aria-label="AI model selector">
                        @foreach (var dep in _deployments)
                        {
                            <option value="@dep">@dep</option>
                        }
                    </select>
                    @if (_modelDirty)
                    {
                        <button class="ascii-btn apply-model-btn" @onclick="ApplyModelAsync" disabled="@_modelApplying">
                            @(_modelApplying ? "[ Applying… ]" : "[ Apply ]")
                        </button>
                    }
                </div>

                @if (!string.IsNullOrWhiteSpace(_modelMessage))
                {
                    <pre class="clear-status">@_modelMessage</pre>
                }
            </div>

            @if (_uploaded)
            {
                <div class="session-tuning-card ascii-border-double vibe-glass-card">
                    <div class="tuning-header">🎬 DIRECTING CONFIG &amp; FRAMING</div>

                    <div class="tuning-grid">
                        <div class="tuning-group">
                            <label class="tuning-label">ASPECT RATIO</label>
                            <div class="aspect-ratio-buttons">
                                <button type="button" class="ascii-btn aspect-btn @(_aspectRatio == "original" ? "is-active" : "")"
                                        @onclick='() => SetAspectRatio("original")'>
                                    16:9
                                </button>
                                <button type="button" class="ascii-btn aspect-btn @(_aspectRatio == "9:16" ? "is-active" : "")"
                                        @onclick='() => SetAspectRatio("9:16")'>
                                    9:16
                                </button>
                                <button type="button" class="ascii-btn aspect-btn @(_aspectRatio == "1:1" ? "is-active" : "")"
                                        @onclick='() => SetAspectRatio("1:1")'>
                                    1:1
                                </button>
                            </div>
                        </div>

                        <div class="tuning-group">
                            <label class="tuning-label">DIRECTOR PERSONA</label>
                            <select class="ai-model-dropdown-select persona-select" @bind="_memePersona" @bind:after="OnPersonaChanged">
                                <option value="Standard">Standard Modern Meme</option>
                                <option value="Brainrot">Gen-Z Brainrot (Chaos / Vine Boom)</option>
                                <option value="MLG">2016 MLG Parody (Airhorn / Hitmarkers)</option>
                                <option value="Sitcom">90s TV Sitcom (Punchline &amp; Laughs)</option>
                                <option value="Drama">Cinematic Drama Thriller</option>
                                <option value="Anime">Anime Melodrama</option>
                            </select>
                        </div>

                        @if (_videoDurationSeconds > 3)
                        {
                            <div class="tuning-group tuning-group-wide">
                                <label class="tuning-label">
                                    TRIM TIMELINE: @(_trimStart.ToString("F1"))s - @(_trimEnd.ToString("F1"))s (@((_trimEnd - _trimStart).ToString("F1"))s selected)
                                </label>
                                <div class="trim-row">
                                    <span class="trim-label">Start:</span>
                                    <input type="range" min="0" max="@(_videoDurationSeconds - 1)" step="0.5"
                                           @bind="_trimStart" @bind:after="OnTrimChanged" class="trim-slider" />
                                    <span class="trim-label">End:</span>
                                    <input type="range" min="@(_trimStart + 1)" max="@_videoDurationSeconds" step="0.5"
                                           @bind="_trimEnd" @bind:after="OnTrimChanged" class="trim-slider" />
                                </div>
                            </div>
                        }
                    </div>
                </div>

                <div class="controls-card ascii-border-double vibe-glass-card">
                    <label class="ascii-toggle">
                        <input type="checkbox" @bind="_aggressiveVisuals" />
                        [ AGGRESSIVE VISUALS : @(_aggressiveVisuals ? "ON " : "OFF") ]
                    </label>

                    <button class="ascii-btn primary-action source-create-btn"
                            @onclick="OnInitiate"
                            disabled="@(_initiating || _visionInProgress)">
                        @if (_visionInProgress)
                        {
                            <span>[ Analysing… please wait ]</span>
                        }
                        else
                        {
                            <span>@(_initiating ? "[ Starting… ]" : "[ Create Meme Video ]")</span>
                        }
                    </button>

                    <button class="ascii-btn compact-btn" @onclick='() => Nav.NavigateTo("/results")'>[ View History ]</button>
                </div>
            }
        </div>
    </div>

    @if (_soundLibraryEmpty)
    {
        <div class="source-bottom-alert">
            <pre class="page-error">⚠ SOUND LIBRARY IS EMPTY — Seed via: dotnet run -- seed-sounds</pre>
        </div>
    }

    @if (!string.IsNullOrEmpty(_errorMessage))
    {
        <div class="source-bottom-alert">
            <pre class="page-error">⚠ @_errorMessage</pre>
        </div>
    }
</div>
