@implements IDisposable

<div class="director-script-container">
    <div class="panel-header script-panel-header">
        <span>[ 🎬 DIRECTOR'S CUE STREAM ]</span>
        <span class="script-count">@_entries.Count cue@(_entries.Count == 1 ? "" : "s")</span>
    </div>

    <div class="script-feed">
        @if (_entries.Count == 0)
        {
            <div class="director-thinking">
                <span class="pulsing-dot">●</span> [ AI DIRECTOR SYNTHESIZING MEME SCRIPT… ]
            </div>
        }
        @foreach (var (entry, idx) in _entries.Select((e, i) => (e, i + 1)))
        {
            <div class="script-cue-card ascii-border-single">
                <div class="cue-card-top">
                    <span class="cue-num">HIT #@idx</span>
                    <span class="cue-time">@((entry.TimestampMs / 1000.0).ToString("F1"))s</span>
                    @if (entry.IsIronic)
                    {
                        <span class="rz-badge rz-badge-warning">IRONIC</span>
                    }
                    @if (entry.VisualEffect.HasValue)
                    {
                        <span class="rz-badge rz-badge-info">@entry.VisualEffect</span>
                    }
                </div>

                @if (!string.IsNullOrWhiteSpace(entry.SelectionRationale))
                {
                    <div class="cue-rationale">"@entry.SelectionRationale"</div>
                }

                <div class="cue-meta-line">
                    <span class="cue-sound-id">Sound: @entry.SoundId.ToString()[..8]…</span>
                    <span class="cue-placement">[@entry.PlacementType]</span>
                </div>
            </div>
        }
    </div>
</div>

@code {
    [Parameter, EditorRequired] public EngineHubClient HubClient { get; set; } = null!;

    private readonly List<ScriptEntryDto> _entries = new();

    protected override void OnInitialized()
    {
        HubClient.DirectorScriptEntry += OnEntry;
    }

    private void OnEntry(ScriptEntryDto entry)
    {
        _entries.Add(entry);
        InvokeAsync(StateHasChanged);
    }

    public void Dispose()
    {
        HubClient.DirectorScriptEntry -= OnEntry;
    }
}
