@implements IDisposable

<div class="director-log-container">
    <div class="panel-header log-panel-header">[ 📜 DIRECTOR'S LOG STREAM ]</div>
    <div class="director-log-feed" @ref="_feedRef">
        @if (_lines.Count == 0)
        {
            <div class="log-waiting">[ AWAITING PROCESSING TELEMETRY… ]</div>
        }
        @foreach (var line in _lines)
        {
            <div class="log-line">@line</div>
        }
    </div>
</div>

@code {
    [Parameter, EditorRequired] public EngineHubClient HubClient { get; set; } = null!;

    private readonly List<string> _lines = new();
    private ElementReference _feedRef;

    protected override void OnInitialized()
    {
        HubClient.DirectorLogEntry += OnLog;
    }

    private void OnLog(string message)
    {
        if (_lines.Count >= 500)
            _lines.RemoveAt(0);

        _lines.Add(message);
        InvokeAsync(StateHasChanged);
    }

    public void Dispose()
    {
        HubClient.DirectorLogEntry -= OnLog;
    }
}
