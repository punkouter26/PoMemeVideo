@using Microsoft.AspNetCore.Components.Forms
@using PoMemeVideo.Client.Services
@inject IJSRuntime JS
@inject CyberAudioService Audio

<div id="ascii-drop-zone-container"
     class="ascii-drop-zone @(_isDragOver ? "drag-over" : "")"
     @ondragenter="OnDragEnter"
     @ondragover="OnDragOver"
     @ondragleave="OnDragLeave">

    <canvas id="dropzone-physics-canvas" class="dropzone-physics-canvas" aria-hidden="true"></canvas>

    @* Invisible overlay covering the entire dropzone so native file drops and clicks trigger Blazor's InputFile *@
    <InputFile id="ascii-file-input"
               OnChange="OnFileInputChange"
               accept=".mp4,.mov,.avi,.webm"
               class="dropzone-file-input-overlay" />

    <div class="ascii-border-double dropzone-art-wrap">
        <pre class="drop-zone-art">
╔══════════════════════════════════════╗
║                                      ║
║     DROP VIDEO FILE HERE             ║
║                                      ║
║     [ mp4 / mov / avi / webm ]       ║
║     [ max 500 MB               ]     ║
║                                      ║
╚══════════════════════════════════════╝</pre>

        @if (!string.IsNullOrEmpty(_errorMessage))
        {
            <div class="drop-error">
                <pre>⚠ @_errorMessage</pre>
            </div>
        }

        <div class="dropzone-browse-prompt">
            <span class="ascii-btn dropzone-browse-btn">[ BROWSE FILE ]</span>
        </div>
    </div>
</div>

@code {
    private static readonly HashSet<string> AllowedExtensions =
        new(StringComparer.OrdinalIgnoreCase) { ".mp4", ".mov", ".avi", ".webm" };

    private const long MaxFileSizeBytes = 500L * 1024 * 1024;

    [Parameter] public EventCallback<IBrowserFile> OnFileAccepted { get; set; }

    private bool _isDragOver;
    private string? _errorMessage;

    private void OnDragEnter(DragEventArgs _) => _isDragOver = true;
    private void OnDragOver(DragEventArgs _) => _isDragOver = true;
    private void OnDragLeave(DragEventArgs _) => _isDragOver = false;

    private async Task OnFileInputChange(InputFileChangeEventArgs e)
    {
        _isDragOver = false;
        _errorMessage = null;

        if (e.FileCount == 0) return;

        var file = e.File;
        var extension = Path.GetExtension(file.Name);

        if (!AllowedExtensions.Contains(extension))
        {
            _errorMessage = $"INVALID FORMAT: '{extension}' not supported. Use mp4, mov, avi, or webm.";
            return;
        }

        if (file.Size > MaxFileSizeBytes)
        {
            _errorMessage = $"FILE TOO LARGE: {file.Size / 1024 / 1024} MB exceeds 500 MB limit.";
            return;
        }

        try
        {
            await JS.InvokeVoidAsync("dropzonePhysics.triggerDropImpact");
        }
        catch { }

        await OnFileAccepted.InvokeAsync(file);
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            try
            {
                await JS.InvokeVoidAsync("dropzonePhysics.init", "dropzone-physics-canvas", "ascii-drop-zone-container");
            }
            catch { }
        }
    }
}
