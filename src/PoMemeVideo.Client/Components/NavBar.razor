@* NavBar.razor
   Retro-terminal styled navigation bar displayed on all pages via MainLayout.
   Reads auth identity from GET /api/auth/me and displays:
         - "GUEST<random> LOGGED IN" for guest identities (GUEST\d{8})
     - User email for Microsoft OAuth authenticated users + LOG OUT button
     - "[ GUEST ]" when no session is active
   Styled with retro-terminal.css ASCII horizontal rule separator.

   Auth state is sourced from CascadingAuthenticationState, so login/logout
   triggers re-renders via AuthenticationStateChanged — no background polling. *@
@inject HttpClient Http
@inject IJSRuntime JS
@inject NavigationManager Nav
@inject NavRefreshService NavRefresh
@inject AuthenticationStateProvider AuthProvider
@implements IDisposable
@implements IAsyncDisposable

<nav class="retro-navbar" role="navigation" aria-label="Site navigation">
    <div class="nav-status-cluster">
        <button class="ascii-btn compact-btn mobile-menu-toggle" @onclick="ToggleMobileMenu" aria-label="Toggle navigation menu">
            @(_mobileMenuOpen ? "[ ✕ ]" : "[ ☰ ]")
        </button>
        <NavLink class="brand flicker" href="/" Match="NavLinkMatch.All">PoMemeVideo</NavLink>
    </div>

    <div class="nav-links desktop-nav-links">
        <NavLink href="/" Match="NavLinkMatch.All">[ CREATE ]</NavLink>
        <NavLink href="/memelibrary">[ SOUNDS ]</NavLink>
        <NavLink href="/results">[ HISTORY ]</NavLink>
        <a href="/scalar/" target="_blank" rel="noopener noreferrer" class="nav-api-link" hidden="@(!_isDevelopment)">[ API ]</a>
    </div>

    <div class="status-cluster" aria-label="Runtime status">
        <span class="auth-status">
            @if (_authDisplay is not null)
            {
                @_authDisplay
            }
            else
            {
                <span class="status-placeholder">[ GUEST ]</span>
            }
        </span>

        @if (_isAuthenticated)
        {
            <form method="post" action="/auth/logout" class="logout-form">
                <button type="submit" class="ascii-btn logout-btn" aria-label="Log out">[ LOG OUT ]</button>
            </form>
        }
    </div>
</nav>

@if (_mobileMenuOpen)
{
    <div class="mobile-nav-drawer ascii-border-double vibe-glass-card reveal-in">
        <NavLink href="/" Match="NavLinkMatch.All" @onclick="CloseMobileMenu" class="mobile-nav-link">[ 🎬 CREATE MEME VIDEO ]</NavLink>
        <NavLink href="/memelibrary" @onclick="CloseMobileMenu" class="mobile-nav-link">[ 🔊 SOUND LIBRARY ]</NavLink>
        <NavLink href="/results" @onclick="CloseMobileMenu" class="mobile-nav-link">[ 📜 VIDEO HISTORY ]</NavLink>
        @if (_isDevelopment)
        {
            <a href="/scalar/" target="_blank" rel="noopener noreferrer" @onclick="CloseMobileMenu" class="mobile-nav-link">[ 🛠️ SCALAR API DOCS ]</a>
        }
    </div>
}
<hr class="retro-navbar-divider" />

@code {
    private string? _authDisplay;
    private string? _aiDisplay;
    private string? _mockDisplay;
    private bool _isAuthenticated;
    private bool _isDevelopment;
    private bool _mobileMenuOpen;
    private void ToggleMobileMenu()
    {
        _mobileMenuOpen = !_mobileMenuOpen;
    }

    private void CloseMobileMenu()
    {
        _mobileMenuOpen = false;
    }

    protected override async Task OnInitializedAsync()
    {
        await LoadAuthAsync();
        await LoadAiAsync();
        await LoadConfigAsync();
        NavRefresh.Subscribe(OnAiChangedAsync);

        // React to login/logout via the authentication state provider instead of polling.
        AuthProvider.AuthenticationStateChanged += OnAuthStateChanged;
    }

    private async void OnAuthStateChanged(Task<AuthenticationState> _)
    {
        await LoadAuthAsync();
        await InvokeAsync(StateHasChanged);
    }

    private async Task OnAiChangedAsync()
    {
        await LoadAiAsync();
        await LoadConfigAsync();
        await InvokeAsync(StateHasChanged);
    }

    private async Task LoadConfigAsync()
    {
        try
        {
            var config = await Http.GetFromJsonAsync<ConfigResponse>("/api/config");
            _mockDisplay = config?.UseMockAI == true ? "[ USING MOCK DATA ]" : null;
            _isDevelopment = config?.IsDevelopment ?? false;
        }
        catch
        {
            _mockDisplay = null;
            _isDevelopment = false;
        }
    }

    private async Task LoadAiAsync()
    {
        try
        {
            var ai = await Http.GetFromJsonAsync<AiModelResponse>("/api/config/ai-model");
            if (ai is null)
            {
                _aiDisplay = null;
                return;
            }

            if (ai.Provider == "AzureOpenAI")
            {
                _aiDisplay = "[ AI: OPENAI ]";
                return;
            }

            if (ai.Provider == "AiFoundry")
            {
                _aiDisplay = $"[ AI: {(ai.AiFoundryDeployment ?? "FOUNDRY").ToUpperInvariant()} ]";
                return;
            }

            var selected = ai.LocalModels?.FirstOrDefault(m => m.Id == ai.BrowserLLMModel)?.Label
                           ?? ai.BrowserLLMModel
                           ?? "LOCAL";
            _aiDisplay = $"[ AI: {selected.ToUpperInvariant()} ]";
        }
        catch
        {
            _aiDisplay = null;
        }
    }

    private async Task LoadAuthAsync()
    {
        try
        {
            var me = await Http.GetFromJsonAsync<AuthMeResponse>("/api/auth/me");
            if (me?.DisplayName is { Length: > 0 } name)
            {
                // GUEST\d{8} pattern — dev guest identity.
                if (System.Text.RegularExpressions.Regex.IsMatch(name, @"^GUEST\d{8}$"))
                {
                    _authDisplay = $"[ DEV: GUEST {name} ]";
                }
                // ANON\d{6} pattern — dev anonymous identity (auto-generated).
                else if (System.Text.RegularExpressions.Regex.IsMatch(name, @"^ANON\d{6}$", System.Text.RegularExpressions.RegexOptions.IgnoreCase))
                {
                    _authDisplay = $"[ DEV: ANON {name} ]";
                }
                else
                {
                    // For email addresses, show only the part before @
                    var displayEmail = me.Email ?? name;
                    var atIdx = displayEmail.IndexOf('@');
                    var shortName = atIdx > 0 ? displayEmail[..atIdx] : displayEmail;
                    _authDisplay = $"[ {shortName} ]";
                }

                _isAuthenticated = true;
                await JS.InvokeVoidAsync("localStorage.setItem", "pmv.guestDisplayName", name);
            }
            else
            {
                var guestName = await JS.InvokeAsync<string?>("localStorage.getItem", "pmv.guestDisplayName");
                _authDisplay = System.Text.RegularExpressions.Regex.IsMatch(guestName ?? string.Empty, @"^GUEST\d{8}$")
                    ? $"[ {guestName} ]"
                    : null;
                _isAuthenticated = _authDisplay is not null;
            }
        }
        catch
        {
            var guestName = await JS.InvokeAsync<string?>("localStorage.getItem", "pmv.guestDisplayName");
            _authDisplay = System.Text.RegularExpressions.Regex.IsMatch(guestName ?? string.Empty, @"^GUEST\d{8}$")
                ? $"[ {guestName} ]"
                : null;
            _isAuthenticated = _authDisplay is not null;
        }
    }

    public void Dispose()
    {
        NavRefresh.Unsubscribe();
        AuthProvider.AuthenticationStateChanged -= OnAuthStateChanged;
    }

    public async ValueTask DisposeAsync()
    {
        Dispose();
        await ValueTask.CompletedTask;
    }

    private sealed record AuthMeResponse(string? DisplayName, string? Email);
    private sealed record ConfigResponse(bool UseMockAI, bool IsDevelopment);
    private sealed record AiModelResponse(
        string Provider,
        string? BrowserLLMModel,
        LocalModelInfo[]? LocalModels,
        string? AiFoundryDeployment);
    private sealed record LocalModelInfo(string Id, string Label);
}
