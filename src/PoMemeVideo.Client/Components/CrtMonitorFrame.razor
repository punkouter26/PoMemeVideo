@* CrtMonitorFrame.razor
   Wraps child content in a CRT monitor aesthetic frame.
   Applies SVG displacement-map barrel-bulge filter for spherical distortion.
   GoF: Decorator Pattern — adds visual CRT framing to any content. *@

<svg width="0" height="0" class="crt-filter-defs" aria-hidden="true" focusable="false">
    <defs>
        <filter id="crt-bulge" x="-5%" y="-5%" width="110%" height="110%">
            <feTurbulence type="fractalNoise" baseFrequency="0.02 0.05"
                          numOctaves="2" seed="3" result="noise" />
            <feDisplacementMap in="SourceGraphic" in2="noise"
                               scale="4" xChannelSelector="R" yChannelSelector="G" />
        </filter>
    </defs>
</svg>

@inject IJSRuntime JS

<div class="crt-frame">
    <canvas id="@_canvasId" class="crt-glass-canvas" aria-hidden="true"></canvas>
    <div class="crt-content-wrap">
        @ChildContent
    </div>
</div>

@code {
    [Parameter] public RenderFragment? ChildContent { get; set; }
    private readonly string _canvasId = $"crt-glass-{Guid.NewGuid():N}";

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            try
            {
                await JS.InvokeVoidAsync("crtGlassShader.attach", _canvasId);
            }
            catch { }
        }
    }
}

<style>
    .crt-glass-canvas {
        position: absolute;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        pointer-events: none;
        z-index: 10;
        border-radius: 8px;
    }
    .crt-content-wrap {
        position: relative;
        z-index: 1;
        width: 100%;
        height: 100%;
    }
</style>
