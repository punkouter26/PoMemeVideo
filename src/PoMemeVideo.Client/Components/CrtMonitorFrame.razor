@* CrtMonitorFrame.razor
   Wraps child content in a CRT monitor aesthetic frame.
   Applies SVG displacement-map barrel-bulge filter for spherical distortion.
   GoF: Decorator Pattern — adds visual CRT framing to any content. *@

<svg width="0" height="0" style="position:absolute">
    <defs>
        <filter id="crt-bulge" x="-5%" y="-5%" width="110%" height="110%">
            <feTurbulence type="fractalNoise" baseFrequency="0.02 0.05"
                          numOctaves="2" seed="3" result="noise" />
            <feDisplacementMap in="SourceGraphic" in2="noise"
                               scale="4" xChannelSelector="R" yChannelSelector="G" />
        </filter>
    </defs>
</svg>

<div class="crt-frame" style="filter: url(#crt-bulge);">
    @ChildContent
</div>

@code {
    [Parameter] public RenderFragment? ChildContent { get; set; }
}
