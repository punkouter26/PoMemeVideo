<Project Sdk="Microsoft.NET.Sdk.BlazorWebAssembly">

  <PropertyGroup>
    <!-- Hosted by PoMemeVideo.Api: the API's publish does not run the WASM SDK's
         index.html placeholder substitution, so fingerprinted framework file
         names would 404. Keep plain names and reference them directly. -->
    <WasmFingerprintAssets>false</WasmFingerprintAssets>
    <!-- AOT disabled: smaller build size and faster CI/CD (rule 2) -->
    <PublishTrimmed Condition="'$(Configuration)' == 'Release'">true</PublishTrimmed>
    <InvariantGlobalization Condition="'$(Configuration)' == 'Release'">true</InvariantGlobalization>
    <BlazorWebAssemblyPreserveCollationData>false</BlazorWebAssemblyPreserveCollationData>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly" />
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly.DevServer" PrivateAssets="all" />
    <PackageReference Include="Microsoft.AspNetCore.Components.Authorization" />
    <PackageReference Include="Microsoft.AspNetCore.SignalR.Client" />
    <PackageReference Include="Radzen.Blazor" />
    <!-- Force safe version of Radzen's transitive dep (GHSA-4cv2-4hjh-77rx fixed in >=1.4.0) -->
    <PackageReference Include="System.Linq.Dynamic.Core" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\PoMemeVideo.Shared\PoMemeVideo.Shared.csproj" />
  </ItemGroup>

</Project>
